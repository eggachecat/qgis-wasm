index 000000000..74b522150
--- /dev/null
+++ b/src/app/qgswasmpreset.cpp
@@ -0,0 +1,221 @@
+/***************************************************************************
+    qgswasmpreset.cpp  -  deployment presets for the QGIS desktop running in a browser
+                             -------------------
+    begin                : 2026
+ ***************************************************************************
+ *                                                                         *
+ *   This program is free software; you can redistribute it and/or modify  *
+ *   it under the terms of the GNU General Public License as published by  *
+ *   the Free Software Foundation; either version 2 of the License, or     *
+ *   (at your option) any later version.                                   *
+ *                                                                         *
+ ***************************************************************************/
+#ifdef __EMSCRIPTEN__
+
+#include "qgswasmpreset.h"
+
+#include "qgsfavoritesitem.h"
+#include "qgsmessagelog.h"
+#include "qgsowsconnection.h"
+#include "qgssettings.h"
+#include "qgssettingsentryimpl.h"
+#include "qgswasmtrace.h"
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QRegularExpression>
+#include <QSettings>
+#include <QUrl>
+#include <QVariant>
+
+namespace
+{
+  QJsonObject &presetStorage()
+  {
+    static QJsonObject sPreset;
+    return sPreset;
+  }
+
+  QVariant toVariant( const QJsonValue &value )
+  {
+    if ( value.isDouble() )
+    {
+      const double d = value.toDouble();
+      if ( d == static_cast<double>( static_cast<qlonglong>( d ) ) )
+        return QVariant( static_cast<qlonglong>( d ) );
+      return QVariant( d );
+    }
+    if ( value.isArray() )
+    {
+      QStringList list;
+      const QJsonArray array = value.toArray();
+      for ( const QJsonValue &v : array )
+        list << ( v.isString() ? v.toString() : QString::fromUtf8( QJsonDocument( QJsonObject { { u"v"_s, v } } ).toJson( QJsonDocument::Compact ) ) );
+      return list;
+    }
+    return value.toVariant();
+  }
+} // namespace
+
+QJsonObject QgsWasmPreset::current()
+{
+  return presetStorage();
+}
+
+QString QgsWasmPreset::origin()
+{
+  return presetStorage().value( u"origin"_s ).toString();
+}
+
+void QgsWasmPreset::apply()
+{
+  const QString path = QString::fromLocal8Bit( qgetenv( "QGIS_WASM_PRESET" ) );
+  if ( path.isEmpty() )
+    return;
+  QFile file( path );
+  if ( !file.open( QIODevice::ReadOnly ) )
+  {
+    QgsMessageLog::logMessage( u"Preset file %1 not found"_s.arg( path ), u"Preset"_s, Qgis::MessageLevel::Warning );
+    return;
+  }
+  QJsonParseError error;
+  const QJsonDocument doc = QJsonDocument::fromJson( file.readAll(), &error );
+  if ( !doc.isObject() )
+  {
+    QgsMessageLog::logMessage( u"Preset file %1 is not valid JSON: %2"_s.arg( path, error.errorString() ), u"Preset"_s, Qgis::MessageLevel::Warning );
+    return;
+  }
+  presetStorage() = doc.object();
+  const QJsonObject preset = presetStorage();
+  QGIS_WASM_TRACE( "applying preset" << preset.value( u"name"_s ).toString() );
+
+  QgsSettings settings;
+
+  // settings seeded once: a value the user changed later stays as the user left it
+  const QJsonObject seed = preset.value( u"settings"_s ).toObject();
+  for ( auto it = seed.constBegin(); it != seed.constEnd(); ++it )
+  {
+    if ( !settings.contains( it.key() ) )
+      settings.setValue( it.key(), toVariant( it.value() ) );
+  }
+  // enforced settings: written on every start
+  const QJsonObject enforce = preset.value( u"enforce"_s ).toObject();
+  for ( auto it = enforce.constBegin(); it != enforce.constEnd(); ++it )
+    settings.setValue( it.key(), toVariant( it.value() ) );
+
+  // XYZ basemap connections (Browser panel → XYZ Tiles); kept in sync with the preset
+  const QJsonArray basemaps = preset.value( u"basemaps"_s ).toArray();
+  for ( const QJsonValue &v : basemaps )
+  {
+    const QJsonObject b = v.toObject();
+    const QString name = b.value( u"name"_s ).toString();
+    const QString url = b.value( u"url"_s ).toString();
+    if ( name.isEmpty() || url.isEmpty() )
+      continue;
+    QgsXyzConnectionSettings::settingsUrl->setValue( url, name );
+    QgsXyzConnectionSettings::settingsZmin->setValue( b.value( u"zmin"_s ).toInt( 0 ), name );
+    QgsXyzConnectionSettings::settingsZmax->setValue( b.value( u"zmax"_s ).toInt( 18 ), name );
+    if ( b.contains( u"tilePixelRatio"_s ) )
+      QgsXyzConnectionSettings::settingsTilePixelRatio->setValue( b.value( u"tilePixelRatio"_s ).toDouble( 1 ), name );
+    if ( b.contains( u"interpretation"_s ) )
+      QgsXyzConnectionSettings::settingsInterpretation->setValue( b.value( u"interpretation"_s ).toString(), name );
+    if ( b.value( u"headers"_s ).isObject() )
+      QgsXyzConnectionSettings::settingsHeaders->setValue( b.value( u"headers"_s ).toObject().toVariantMap(), name );
+  }
+
+  // Browser panel favourites, e.g. the cloud mount root
+  const QJsonArray favorites = preset.value( u"favorites"_s ).toArray();
+  if ( !favorites.isEmpty() )
+  {
+    QStringList favDirs = QgsFavoritesItem::settingsFavoriteDirs->value();
+    bool changed = false;
+    for ( const QJsonValue &v : favorites )
+    {
+      const QJsonObject f = v.toObject();
+      const QString dir = f.isEmpty() ? v.toString() : f.value( u"path"_s ).toString();
+      if ( dir.isEmpty() )
+        continue;
+      bool present = false;
+      for ( const QString &existing : std::as_const( favDirs ) )
+        present |= existing.section( u"|||"_s, 0, 0 ) == dir;
+      if ( !present )
+      {
+        favDirs.append( u"%1|||%2"_s.arg( dir, f.value( u"name"_s ).toString() ) );
+        changed = true;
+      }
+    }
+    if ( changed )
+      QgsFavoritesItem::settingsFavoriteDirs->setValue( favDirs );
+  }
+
+  // Qt's Open/Save dialogs: sidebar bookmarks for the cloud mounts, the favourites, home and the demo data, so that
+  // a cloud folder is one click away instead of a typed path. QFileDialog keeps them in QSettings( UserScope,
+  // "QtProject" ) — in this build (no QSettings::setPath on wasm) that is window.localStorage, key
+  // "qt-v0-QtProject-all-apps-FileDialog/shortcuts". Existing bookmarks are kept; missing ones are appended.
+  {
+    QStringList dirs;
+    const QJsonArray mounts = preset.value( u"mounts"_s ).toArray();
+    for ( const QJsonValue &v : mounts )
+    {
+      const QJsonObject m = v.toObject();
+      QString name = m.value( u"name"_s ).toString();
+      if ( name.isEmpty() )
+        name = m.value( u"bucket"_s ).toString();
+      if ( name.isEmpty() )
+        name = m.value( u"type"_s ).toString();
+      if ( name.isEmpty() )
+        continue;
+      dirs << u"/cloud/%1"_s.arg( name.replace( QRegularExpression( u"[^A-Za-z0-9._-]"_s ), u"_"_s ) ); // same rule as the shell's mount paths
+    }
+    for ( const QJsonValue &v : favorites )
+    {
+      const QJsonObject f = v.toObject();
+      dirs << ( f.isEmpty() ? v.toString() : f.value( u"path"_s ).toString() );
+    }
+    dirs << u"/cloud"_s << QDir::homePath() << u"/qgis/share/demo"_s;
+
+    QSettings dialogSettings( QSettings::UserScope, u"QtProject"_s );
+    dialogSettings.beginGroup( u"FileDialog"_s );
+    QStringList shortcuts = dialogSettings.value( u"shortcuts"_s ).toStringList();
+    bool shortcutsChanged = false;
+    if ( shortcuts.isEmpty() )
+    {
+      shortcuts << u"file:"_s; // Qt's default "Computer" entry
+      shortcutsChanged = true;
+    }
+    for ( const QString &dir : std::as_const( dirs ) )
+    {
+      if ( dir.isEmpty() || !QFileInfo( dir ).isDir() )
+        continue;
+      const QString url = QUrl::fromLocalFile( dir ).toString();
+      if ( !shortcuts.contains( url ) )
+      {
+        shortcuts << url;
+        shortcutsChanged = true;
+      }
+    }
+    if ( shortcutsChanged )
+      dialogSettings.setValue( u"shortcuts"_s, shortcuts );
+    if ( !dialogSettings.contains( u"viewMode"_s ) )
+      dialogSettings.setValue( u"viewMode"_s, u"Detail"_s );
+    // QFileDialogPrivate::restoreWidgetState() gives up (and never applies the shortcuts) when neither a sidebar
+    // width nor a saved splitter state is present, so provide the width Qt would otherwise save after a first use
+    if ( !dialogSettings.contains( u"sidebarWidth"_s ) )
+      dialogSettings.setValue( u"sidebarWidth"_s, 150 );
+    QGIS_WASM_TRACE( "file dialog shortcuts" << shortcuts );
+  }
+
+  // compiled-in C++ plugins to enable on first start
+  const QJsonArray plugins = preset.value( u"plugins_cpp"_s ).toArray();
+  for ( const QJsonValue &v : plugins )
+  {
+    const QString key = u"/Plugins/%1"_s.arg( v.toString() );
+    if ( !settings.contains( key ) )
+      settings.setValue( key, true );
+  }
+}
+
+#endif // __EMSCRIPTEN__
