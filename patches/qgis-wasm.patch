+                  QTimer::singleShot( 300, dialog, [dialog, &shown]() { shown = dialog->isVisible() && dialog->windowHandle() && dialog->windowHandle()->isExposed(); } );
+                  const int result = dialog->exec();
+                  return QJsonObject { { u"kind"_s, kind }, { u"parent"_s, parent ? parent->metaObject()->className() : QStringLiteral( "none" ) }, { u"shownAfter300ms"_s, shown }, { u"result"_s, result }, { u"elapsedMs"_s, static_cast<double>( t.elapsed() ) } };
+                } );
+
+  registerTool( u"ui_message"_s, u"Show a message in the QGIS message bar above the map."_s,
+                schema( { { u"text"_s, prop( u"string"_s, u"Message text"_s ) }, { u"title"_s, prop( u"string"_s, u"Bold title (optional)"_s ) },
+                          { u"level"_s, prop( u"string"_s, u"info (default), success, warning, critical"_s, QJsonArray { u"info"_s, u"success"_s, u"warning"_s, u"critical"_s } ) },
+                          { u"duration"_s, prop( u"integer"_s, u"Seconds before the message disappears (0 = until closed)"_s ) } },
+                        { u"text"_s } ),
+                []( const QJsonObject &p ) -> QJsonValue {
+                  const QString level = str( p, u"level"_s, u"info"_s );
+                  Qgis::MessageLevel l = Qgis::MessageLevel::Info;
+                  if ( level == "success"_L1 )
+                    l = Qgis::MessageLevel::Success;
+                  else if ( level == "warning"_L1 )
+                    l = Qgis::MessageLevel::Warning;
+                  else if ( level == "critical"_L1 )
+                    l = Qgis::MessageLevel::Critical;
+                  QgisApp::instance()->messageBar()->pushMessage( str( p, u"title"_s ), requireStr( p, u"text"_s ), l, integer( p, u"duration"_s, -1 ) );
+                  return true;
+                } );
+
+  // ---------------------------------------------------------------- C++ plugins compiled into this build
+  registerTool( u"plugins_list"_s, u"List the C++ plugins compiled into this build (Plugins → Manage and Install Plugins) and whether they are loaded."_s, schema(), []( const QJsonObject & ) -> QJsonValue {
+    QJsonArray a;
+    const QList<QgsWasmStaticPlugin> plugins = qgisWasmStaticPlugins();
+    for ( const QgsWasmStaticPlugin &sp : plugins )
+    {
+      a.append( QJsonObject { { u"key"_s, sp.key }, { u"name"_s, *sp.name() }, { u"description"_s, *sp.description() }, { u"category"_s, *sp.category() }, { u"version"_s, *sp.version() },
+                              { u"loaded"_s, QgsPluginRegistry::instance()->isLoaded( sp.key ) } } );
+    }
