+
+  registerTool( u"ui_remove_action"_s, u"Remove a menu entry / toolbar button added with ui_add_action."_s, schema( { { u"id"_s, prop( u"string"_s, u"Action id"_s ) } }, { u"id"_s } ), [this]( const QJsonObject &p ) -> QJsonValue {
