+                  else
+                    QgsPluginRegistry::instance()->unloadCppPlugin( key );
+                  return QJsonObject { { u"key"_s, key }, { u"loaded"_s, QgsPluginRegistry::instance()->isLoaded( key ) } };
+                } );
