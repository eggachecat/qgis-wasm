diff --git a/src/app/qgswasmapp.cpp b/src/app/qgswasmapp.cpp
new file mode 100644
index 000000000..4f501ab02
--- /dev/null
+++ b/src/app/qgswasmapp.cpp
@@ -0,0 +1,149 @@
+/***************************************************************************
+    qgswasmapp.cpp  -  the WebAssembly hooks of the QGIS desktop application
+                             -------------------
+    begin                : 2026
+ ***************************************************************************
+ *                                                                         *
+ *   This program is free software; you can redistribute it and/or modify  *
+ *   it under the terms of the GNU General Public License as published by  *
+ *   the Free Software Foundation; either version 2 of the License, or     *
+ *   (at your option) any later version.                                   *
+ *                                                                         *
+ ***************************************************************************/
+#include "qgswasmapp.h"
+
+#include "qgisapp.h"
+#include "qgsapplication.h"
+#include "qgsfontmanager.h"
+#include "qgsnewsfeedparser.h"
+#include "qgssettingsentryimpl.h"
+#include "qgswasmbridge.h"
+#include "qgswasmpreset.h"
+#include "qgswasmtrace.h"
+
+#include <QCoreApplication>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QMetaObject>
+#include <QScreen>
+#include <QThread>
+#include <QTimer>
+
+#include <emscripten.h>
+
+static bool sQgisWasmReady = false; // set once QgisApp::completeInitialization() has run
+
+// ---------------------------------------------------------------- JavaScript entry points
+//
+// The work is queued into Qt's event loop instead of being run inside the export: the Qt for WebAssembly main loop
+// is suspended (JSPI) between events, and C++ that itself suspends while running on a second stack breaks Qt's
+// suspend/resume bookkeeping. Posting an event wakes the loop, which then performs the work from inside
+// processEvents() like any other event (docs/02-运行时与调试.md §2.1).
+extern "C"
+{
+  //! Opens a project or a data file that lives in the virtual filesystem (QgisApp::openFile, with QGIS' own dialogs).
+  //! Returns 0 while QGIS is still starting up.
+  EMSCRIPTEN_KEEPALIVE int qgis_wasm_open( const char *path )
+  {
+    QgisApp *app = QgisApp::instance();
+    if ( !app || !app->isVisible() || !sQgisWasmReady ) // not ready until the main window is up and initialised
+      return 0;
+    const QString fileName = QString::fromUtf8( path );
+    QGIS_WASM_TRACE( "queue openFile" << fileName );
+    QMetaObject::invokeMethod( app, [app, fileName]() {
+      QGIS_WASM_TRACE( "openFile" << fileName );
+      app->openFile( fileName );
+      QGIS_WASM_TRACE( "openFile done" << fileName );
+    }, Qt::QueuedConnection );
+    return 1;
+  }
+
+  //! 1 once the main window is up and the bridge accepts calls (pure query, never suspends)
+  EMSCRIPTEN_KEEPALIVE int qgis_wasm_ready()
+  {
+    QgisApp *app = QgisApp::instance();
+    return ( app && sQgisWasmReady ) ? 1 : 0;
+  }
+
+  //! Tool call (see QgsWasmBridge): runs tool \a method with the JSON object \a paramsJson inside Qt's event loop and
+  //! delivers the result to Module.qgisBridgeResolve(requestId, json). Returns 0 while QGIS is still starting up.
+  EMSCRIPTEN_KEEPALIVE int qgis_wasm_call( int requestId, const char *method, const char *paramsJson )
+  {
+    QgisApp *app = QgisApp::instance();
+    if ( !app || !sQgisWasmReady )
+      return 0;
+    const QString name = QString::fromUtf8( method );
+    const QByteArray params( paramsJson ? paramsJson : "{}" );
+    QMetaObject::invokeMethod( app, [requestId, name, params]() {
+      QGIS_WASM_TRACE( "tool" << name );
+      QgsWasmBridge::instance()->callFromJs( requestId, name, QJsonDocument::fromJson( params ).object() );
+    }, Qt::QueuedConnection );
+    return 1;
+  }
+}
+
+// ---------------------------------------------------------------- hooks
+
+void QgsWasmApp::beforeApplication()
+{
+  // Qt for WebAssembly's "native" file dialogs are the browser's file picker / download: QFileDialog::getSaveFileName()
+  // returns an empty string and open dialogs upload files. Use Qt's own dialogs, which browse the virtual filesystem
+  // (/cloud/<mount>/…, /home/web_user/…) like on the desktop.
+  QCoreApplication::setAttribute( Qt::AA_DontUseNativeDialogs );
+}
+
+void QgsWasmApp::applyDeploymentDefaults()
+{
+  // fonts bundled with the build (e.g. Open Sans used by the default style) live in <data>/fonts; register them
+  // before anything asks for a font family, otherwise QGIS tries to download them from the internet
+  QgsApplication::fontManager()->addUserFontDirectory( QgsApplication::pkgDataPath() + QStringLiteral( "/fonts" ) );
+  // every QThread is a Web Worker holding its own instance of the (large) module: keep the render pool small
+  QgsApplication::setMaxThreads( std::min( QThread::idealThreadCount(), 8 ) );
+  // settings entries read the user profile only (not the global settings ini): seed browser-friendly defaults once
+  if ( !QgsFontManager::settingsDownloadMissingFonts->exists() )
+    QgsFontManager::settingsDownloadMissingFonts->setValue( false ); // cross-origin font downloads are blocked by browsers
+  const QString newsFeedKey = QgsNewsFeedParser::keyForFeed( QStringLiteral( "https://feed.qgis.org/" ) );
+  if ( !QgsNewsFeedParser::settingsFeedDisabled->exists( newsFeedKey ) )
+    QgsNewsFeedParser::settingsFeedDisabled->setValue( true, newsFeedKey ); // feed.qgis.org sends no CORS headers
+}
+
+void QgsWasmApp::beforeMainWindow()
+{
+  // deployment preset (settings, basemaps, favourites, file dialog bookmarks) written by the shell page
+  QgsWasmPreset::apply();
+}
+
+void QgsWasmApp::showMainWindow( QgisApp *qgis )
+{
+  // The browser page is the screen: fill it. Qt for WebAssembly draws a title bar (minimise / maximise / close
+  // buttons) around top-level windows; the shell page hides it for the maximised main window (web/shell). With the
+  // bar hidden the platform window is full size but Qt does not propagate that size to the widget, so it is set
+  // explicitly here and whenever the page (= screen) is resized, e.g. when the web agent's panel opens.
+  //
+  // QgisApp's constructor restored a desktop geometry (default: 80 % of the screen at a 10 % offset), so the first
+  // frames show that smaller window before the maximise and the explicit geometry take effect. A frameless window
+  // sized before show() avoids those frames but leaves the welcome page's QML view at its minimum size (Qt wasm
+  // never sends it the resize), so the maximise path stays and the page keeps its loading screen up until the
+  // window has settled (loading.js: the "settle" hold).
+  qgis->showMaximized();
+  const auto fitToScreen = [qgis]() {
+    if ( QScreen *screen = qgis->screen() )
+    {
+      const QRect geometry = screen->geometry();
+      if ( geometry.isValid() && qgis->geometry() != geometry )
+        qgis->setGeometry( geometry );
+    }
+  };
+  QTimer::singleShot( 0, qgis, fitToScreen );
+  QTimer::singleShot( 1000, qgis, fitToScreen );
+  if ( QScreen *screen = qgis->screen() )
+    QObject::connect( screen, &QScreen::geometryChanged, qgis, [fitToScreen]( const QRect & ) { QTimer::singleShot( 0, fitToScreen ); } );
+}
+
+void QgsWasmApp::afterInitialization( QgisApp *qgis )
+{
+  Q_UNUSED( qgis )
+  // control surface for the page, MCP clients, web plugins and the web agent (web/agent)
+  QgsWasmBridge::instance()->attachToApp();
+  sQgisWasmReady = true;
+}
