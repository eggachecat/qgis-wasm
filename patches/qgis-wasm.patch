@@ -0,0 +1,47 @@
+/***************************************************************************
+    qgswasmapp.h  -  the WebAssembly hooks of the QGIS desktop application
+                             -------------------
+    begin                : 2026
+ ***************************************************************************
+ *                                                                         *
+ *   This program is free software; you can redistribute it and/or modify  *
+ *   it under the terms of the GNU General Public License as published by  *
+ *   the Free Software Foundation; either version 2 of the License, or     *
+ *   (at your option) any later version.                                   *
+ *                                                                         *
+ ***************************************************************************/
+#ifndef QGSWASMAPP_H
+#define QGSWASMAPP_H
+
+#ifdef __EMSCRIPTEN__
+
+class QgisApp;
+
+/**
+ * \brief Everything main() does differently in a browser, as five hooks.
+ *
+ * main.cpp calls these at fixed points so that the upstream file carries only one-line changes (a QGIS upgrade
+ * re-applies a handful of trivial hunks; the browser-specific behaviour lives here and in qgswasm*.cpp). The
+ * JavaScript entry points (qgis_wasm_open / qgis_wasm_ready / qgis_wasm_call, see cmake/QgisWasmApp.cmake) are
+ * defined in qgswasmapp.cpp as well.
+ */
+namespace QgsWasmApp
+{
+  //! Before QgsApplication is constructed (application attributes)
+  void beforeApplication();
+
+  //! Right after QgsApplication exists: bundled fonts, thread pool size, browser-friendly default settings
+  void applyDeploymentDefaults();
+
+  //! Before the main window is created: deployment preset (settings, basemaps, favourites, …)
+  void beforeMainWindow();
+
+  //! Shows the main window and keeps it the size of the page (the page is the screen)
+  void showMainWindow( QgisApp *qgis );
+
+  //! After QgisApp::completeInitialization(): control surface for the page / MCP / agents, ready flag
+  void afterInitialization( QgisApp *qgis );
+} // namespace QgsWasmApp
+
+#endif // __EMSCRIPTEN__
+#endif // QGSWASMAPP_H
