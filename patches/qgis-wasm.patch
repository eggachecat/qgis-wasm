+  registerTool( u"ui_trigger_action"_s, u"Trigger a menu entry added with ui_add_action, or one of QGIS' own actions by object name (e.g. mActionAddOgrLayer, mActionSaveProjectAs, mActionZoomFullExtent), as if the user clicked it."_s, schema( { { u"id"_s, prop( u"string"_s, u"Action id (ui_add_action) or QGIS action object name"_s ) } }, { u"id"_s } ), [this]( const QJsonObject &p ) -> QJsonValue {
