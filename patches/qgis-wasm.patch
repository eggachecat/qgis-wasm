+// ------------------------------------------------------------------------------------------------------------
+
+QgsWasmBridge *QgsWasmBridge::instance()
+{
+  static QgsWasmBridge *sInstance = new QgsWasmBridge();
+  return sInstance;
+}
+
+QgsWasmBridge::QgsWasmBridge()
+  : QObject( nullptr )
+{
+  registerBuiltinTools();
+}
+
+void QgsWasmBridge::registerTool( const QString &name, const QString &description, const QJsonObject &inputSchema, const ToolFunction &function )
+{
+  mTools.insert( name, Tool { name, description, inputSchema, function } );
+}
+
+QJsonArray QgsWasmBridge::tools() const
+{
+  QJsonArray a;
+  for ( const Tool &t : mTools )
+    a.append( QJsonObject { { u"name"_s, t.name }, { u"description"_s, t.description }, { u"inputSchema"_s, t.inputSchema } } );
+  return a;
+}
+
+QStringList QgsWasmBridge::toolNames() const
+{
+  return mTools.keys();
+}
+
+bool QgsWasmBridge::hasTool( const QString &name ) const
+{
+  return mTools.contains( name );
+}
+
+QJsonObject QgsWasmBridge::call( const QString &name, const QJsonObject &params )
+{
+  const auto it = mTools.constFind( name );
+  if ( it == mTools.constEnd() )
+    return QJsonObject { { u"ok"_s, false }, { u"error"_s, u"unknown tool '%1'"_s.arg( name ) } };
+
+  QJsonObject result;
+  try
+  {
+    const QJsonValue value = it->function( params );
+    result = QJsonObject { { u"ok"_s, true }, { u"result"_s, value } };
+  }
+  catch ( const QgsWasmBridgeError &e )
+  {
+    result = QJsonObject { { u"ok"_s, false }, { u"error"_s, QString::fromStdString( e.what() ) } };
+  }
+  catch ( const QgsException &e )
+  {
+    result = QJsonObject { { u"ok"_s, false }, { u"error"_s, e.what() } };
+  }
+  catch ( const std::exception &e )
+  {
+    result = QJsonObject { { u"ok"_s, false }, { u"error"_s, QString::fromUtf8( e.what() ) } };
+  }
+  emit toolCalled( name, params, result );
+  return result;
+}
+
+void QgsWasmBridge::callFromJs( int requestId, const QString &name, const QJsonObject &params )
+{
+  const QJsonObject result = call( name, params );
+  const QByteArray json = QJsonDocument( result ).toJson( QJsonDocument::Compact );
+  qgis_wasm_bridge_resolve( requestId, json.constData() );
+}
+
+void QgsWasmBridge::emitEvent( const QString &type, const QJsonObject &payload )
+{
+  const QByteArray json = QJsonDocument( payload ).toJson( QJsonDocument::Compact );
+  qgis_wasm_bridge_event( type.toUtf8().constData(), json.constData() );
+}
+
+// --- helpers --------------------------------------------------------------------------------------------------
+
+QgsMapLayer *QgsWasmBridge::resolveLayer( const QString &reference )
+{
+  QgsProject *project = QgsProject::instance();
+  if ( QgsMapLayer *layer = project->mapLayer( reference ) )
+    return layer;
+  const QList<QgsMapLayer *> byName = project->mapLayersByName( reference );
+  if ( !byName.isEmpty() )
+    return byName.first();
+  throw QgsWasmBridgeError( u"no layer with id or name '%1'"_s.arg( reference ) );
+}
+
+QJsonObject QgsWasmBridge::rectToJson( const QgsRectangle &rect, const QString &crs )
+{
+  return QJsonObject { { u"xmin"_s, rect.xMinimum() }, { u"ymin"_s, rect.yMinimum() }, { u"xmax"_s, rect.xMaximum() }, { u"ymax"_s, rect.yMaximum() }, { u"crs"_s, crs } };
+}
+
+QJsonValue QgsWasmBridge::variantToJson( const QVariant &value )
+{
+  if ( !value.isValid() || value.isNull() )
+    return QJsonValue();
+  const QJsonValue v = QJsonValue::fromVariant( value );
+  if ( v.isUndefined() )
+    return value.toString();
+  return v;
+}
+
+QJsonObject QgsWasmBridge::layerToJson( QgsMapLayer *layer )
+{
+  QJsonObject o;
+  o[u"id"_s] = layer->id();
+  o[u"name"_s] = layer->name();
+  o[u"type"_s] = QgsMapLayerFactory::typeToString( layer->type() );
+  o[u"provider"_s] = layer->providerType();
+  o[u"source"_s] = layer->publicSource();
+  o[u"crs"_s] = layer->crs().authid();
+  o[u"valid"_s] = layer->isValid();
+  if ( QgsLayerTreeLayer *node = QgsProject::instance()->layerTreeRoot()->findLayer( layer->id() ) )
+    o[u"visible"_s] = node->isVisible();
+  o[u"extent"_s] = rectToJson( layer->extent(), layer->crs().authid() );
+  if ( QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer ) )
+  {
+    o[u"geometry"_s] = QgsWkbTypes::geometryDisplayString( vl->geometryType() );
+    o[u"featureCount"_s] = static_cast<double>( vl->featureCount() );
+    o[u"selectedCount"_s] = vl->selectedFeatureCount();
+    QJsonArray fields;
+    const QgsFields f = vl->fields();
+    for ( const QgsField &field : f )
+      fields.append( field.name() );
+    o[u"fields"_s] = fields;
+  }
+  else if ( QgsRasterLayer *rl = qobject_cast<QgsRasterLayer *>( layer ) )
+  {
+    o[u"bands"_s] = rl->bandCount();
+    o[u"width"_s] = rl->width();
+    o[u"height"_s] = rl->height();
+  }
+  return o;
+}
+
+// --- events ---------------------------------------------------------------------------------------------------
+
+void QgsWasmBridge::hookLayer( QgsMapLayer *layer )
+{
+  if ( QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer ) )
+  {
+    connect( vl, &QgsVectorLayer::selectionChanged, this, [this, vl]( const QgsFeatureIds &, const QgsFeatureIds &, bool ) {
+      emitEvent( u"selection.changed"_s, QJsonObject { { u"layer"_s, vl->id() }, { u"name"_s, vl->name() }, { u"count"_s, vl->selectedFeatureCount() } } );
+    } );
+  }
+}
+
+void QgsWasmBridge::attachToApp()
+{
+  if ( mAttached )
+    return;
+  mAttached = true;
+
+  QgsProject *project = QgsProject::instance();
+  connect( project, &QgsProject::readProject, this, [this]( const QDomDocument & ) {
+    emitEvent( u"project.read"_s, QJsonObject { { u"file"_s, QgsProject::instance()->fileName() }, { u"title"_s, QgsProject::instance()->title() } } );
+  } );
+  connect( project, &QgsProject::cleared, this, [this]() { emitEvent( u"project.cleared"_s ); } );
+  connect( project, &QgsProject::layersAdded, this, [this]( const QList<QgsMapLayer *> &layers ) {
+    QJsonArray a;
+    for ( QgsMapLayer *l : layers )
+    {
+      a.append( layerToJson( l ) );
+      hookLayer( l );
+    }
+    emitEvent( u"layers.added"_s, QJsonObject { { u"layers"_s, a } } );
+  } );
+  connect( project, &QgsProject::layersRemoved, this, [this]( const QStringList &ids ) {
+    emitEvent( u"layers.removed"_s, QJsonObject { { u"ids"_s, QJsonArray::fromStringList( ids ) } } );
+  } );
+  const QMap<QString, QgsMapLayer *> layers = project->mapLayers();
+  for ( QgsMapLayer *l : layers )
+    hookLayer( l );
+
+  if ( QgsMapCanvas *canvas = QgisApp::instance()->mapCanvas() )
+  {
+    connect( canvas, &QgsMapCanvas::extentsChanged, this, [this, canvas]() {
+      emitEvent( u"canvas.extent"_s, rectToJson( canvas->extent(), canvas->mapSettings().destinationCrs().authid() ) );
+    } );
+    connect( canvas, &QgsMapCanvas::mapCanvasRefreshed, this, [this]() { emitEvent( u"canvas.refreshed"_s ); } );
+  }
+
+  // QGIS' own message log (providers, Processing, plugins…) as an event, so the page's debug view shows QGIS and web logs in one list
+  connect( QgsApplication::messageLog(), &QgsMessageLog::messageReceivedWithFormat, this, [this]( const QString &message, const QString &tag, Qgis::MessageLevel level, Qgis::StringFormat ) {
+    static const QHash<Qgis::MessageLevel, QString> names { { Qgis::MessageLevel::Info, u"info"_s }, { Qgis::MessageLevel::Warning, u"warning"_s }, { Qgis::MessageLevel::Critical, u"critical"_s }, { Qgis::MessageLevel::Success, u"success"_s }, { Qgis::MessageLevel::NoLevel, u"none"_s } };
+    emitEvent( u"log"_s, QJsonObject { { u"message"_s, message }, { u"tag"_s, tag }, { u"level"_s, names.value( level, u"info"_s ) } } );
+  } );
+  emitEvent( u"ready"_s, QJsonObject { { u"version"_s, Qgis::version() }, { u"tools"_s, QJsonArray::fromStringList( toolNames() ) } } );
+}
+
+// --- the built-in tools -----------------------------------------------------------------------------------------
+
+void QgsWasmBridge::registerBuiltinTools()
+{
+  // ---------------------------------------------------------------- application / project
+  registerTool( u"qgis_version"_s, u"QGIS version and build information of this browser instance."_s, schema(), []( const QJsonObject & ) -> QJsonValue {
+    return QJsonObject { { u"version"_s, Qgis::version() }, { u"release"_s, Qgis::releaseName() }, { u"platform"_s, u"wasm"_s }, { u"maxThreads"_s, QgsApplication::maxThreads() }, { u"bridgeApi"_s, 1 } }; // bridgeApi: major version of the tool contract (docs/05)
+  } );
+
+  registerTool( u"tools_list"_s, u"List all tools available on this QGIS instance with their JSON input schemas."_s, schema(), [this]( const QJsonObject & ) -> QJsonValue {
+    return tools();
+  } );
+
+  registerTool( u"state"_s, u"Snapshot of the current QGIS state: project, layers (in layer-tree order) and the map canvas extent. Call this first to understand what the user is looking at."_s, schema(), []( const QJsonObject & ) -> QJsonValue {
+    return QJsonObject { { u"version"_s, Qgis::version() }, { u"project"_s, projectInfo() }, { u"layers"_s, layersJson() } };
+  } );
+
+  registerTool( u"project_info"_s, u"Information about the current project: file name, title, CRS, layer count, canvas extent."_s, schema(), []( const QJsonObject & ) -> QJsonValue {
+    return projectInfo();
+  } );
+
+  registerTool( u"project_open"_s, u"Open a QGIS project file (.qgs/.qgz) from the virtual filesystem (e.g. /cloud/<mount>/… or /home/web_user/…) or from an http(s) URL. Replaces the current project."_s,
+                schema( { { u"path"_s, prop( u"string"_s, u"Project file path inside the virtual filesystem"_s ) } }, { u"path"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+                  QString path = requireStr( p, u"path"_s );
+                  if ( isUrl( path ) )
+                    path = downloadToVfs( path );
+                  if ( !QFile::exists( path ) )
+                    throw QgsWasmBridgeError( u"file not found: %1"_s.arg( path ) );
+                  if ( !QgisApp::instance()->addProject( path ) )
+                    throw QgsWasmBridgeError( u"could not open project %1"_s.arg( path ) );
+                  return projectInfo();
+                } );
+
+  registerTool( u"project_new"_s, u"Start a new, blank project (unsaved changes of the current project are discarded)."_s, schema(), []( const QJsonObject & ) -> QJsonValue {
+    appFileNewBlank();
+    return projectInfo();
+  } );
+
+  registerTool( u"project_save"_s, u"Save the current project. With 'path' the project is saved to that file (e.g. on a cloud mount: /cloud/<mount>/dir/name.qgz), otherwise to its current file."_s,
+                schema( { { u"path"_s, prop( u"string"_s, u"Target path (.qgs or .qgz). Optional when the project already has a file name."_s ) } } ), []( const QJsonObject &p ) -> QJsonValue {
+                  QgsProject *project = QgsProject::instance();
+                  QString path = str( p, u"path"_s, project->fileName() );
+                  if ( path.isEmpty() )
+                    throw QgsWasmBridgeError( u"the project has no file name yet: pass 'path'"_s );
+                  if ( !path.endsWith( ".qgs"_L1, Qt::CaseInsensitive ) && !path.endsWith( ".qgz"_L1, Qt::CaseInsensitive ) )
+                    path += ".qgz"_L1;
+                  QDir().mkpath( QFileInfo( path ).absolutePath() );
+                  if ( !project->write( path ) )
+                    throw QgsWasmBridgeError( u"saving the project to %1 failed: %2"_s.arg( path, project->error() ) );
+                  return QJsonObject { { u"path"_s, path }, { u"size"_s, static_cast<double>( QFileInfo( path ).size() ) } };
+                } );
+
+  registerTool( u"project_set_crs"_s, u"Set the project (map canvas) coordinate reference system, e.g. EPSG:3857."_s,
+                schema( { { u"crs"_s, prop( u"string"_s, u"CRS as authority:code (EPSG:4326), PROJ string or WKT"_s ) } }, { u"crs"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+                  QgsProject::instance()->setCrs( crsFromString( requireStr( p, u"crs"_s ) ) );
+                  QgisApp::instance()->mapCanvas()->refresh();
+                  return projectInfo();
+                } );
+
+  // ---------------------------------------------------------------- layers
+  registerTool( u"layers_list"_s, u"List the layers of the current project in layer-tree order with id, name, type, provider, source, CRS, visibility, extent and (vector) geometry type, feature count and field names."_s, schema(), []( const QJsonObject & ) -> QJsonValue {
+    return layersJson();
+  } );
+
+  registerTool( u"layers_add"_s,
+                u"Add a layer to the project. 'uri' can be: a file in the virtual filesystem (GeoPackage, Shapefile, GeoJSON, GeoTIFF, CSV, …; all sublayers are added unless 'layer' selects one), an http(s) URL of such a file (downloaded first), "
+                "an XYZ tile URL template containing {z}/{x}/{y} (web basemap), a WMS/WFS/ArcGIS REST URL with 'provider' set, or any QGIS data source URI with 'provider'. "
+                "Project files (.qgs/.qgz) are opened as projects. Returns the added layers."_s,
+                schema( { { u"uri"_s, prop( u"string"_s, u"Path, URL or QGIS data source URI"_s ) },
+                          { u"name"_s, prop( u"string"_s, u"Display name (optional)"_s ) },
+                          { u"provider"_s, prop( u"string"_s, u"QGIS provider key: ogr, gdal, wms (also XYZ tiles), wfs, arcgisfeatureserver, delimitedtext, memory, … (optional, auto-detected for files and {z}/{x}/{y} URLs)"_s ) },
+                          { u"layer"_s, prop( u"string"_s, u"For multi-layer files: only add the sublayer with this name (optional)"_s ) },
+                          { u"zmin"_s, prop( u"integer"_s, u"XYZ tiles: minimum zoom (default 0)"_s ) },
+                          { u"zmax"_s, prop( u"integer"_s, u"XYZ tiles: maximum zoom (default 18)"_s ) } },
+                        { u"uri"_s } ),
+                []( const QJsonObject &p ) -> QJsonValue {
+                  QgisApp *app = QgisApp::instance();
+                  QString uri = requireStr( p, u"uri"_s );
+                  const QString name = str( p, u"name"_s );
+                  QString provider = str( p, u"provider"_s );
+                  const QString only = str( p, u"layer"_s );
+                  QList<QgsMapLayer *> added;
+
+                  // remote data file (GeoJSON, GeoPackage, GeoTIFF, … on a CDN / object storage URL): fetch it first
+                  if ( isUrl( uri ) && ( provider.isEmpty() || provider == "ogr"_L1 || provider == "gdal"_L1 ) && !uri.contains( "{z}"_L1 ) && !uri.contains( "{x}"_L1 ) )
+                  {
+                    uri = downloadToVfs( uri );
+                    provider.clear(); // let the providers describe the downloaded file
+                  }
+
+                  if ( uri.endsWith( ".qgs"_L1, Qt::CaseInsensitive ) || uri.endsWith( ".qgz"_L1, Qt::CaseInsensitive ) )
+                  {
+                    if ( !app->addProject( uri ) )
+                      throw QgsWasmBridgeError( u"could not open project %1"_s.arg( uri ) );
+                    return QJsonObject { { u"project"_s, projectInfo() }, { u"layers"_s, layersJson() } };
+                  }
+
+                  // web basemaps: XYZ template → wms provider with an xyz uri
+                  if ( provider == "xyz"_L1 || ( ( provider.isEmpty() || provider == "wms"_L1 ) && uri.contains( "{z}"_L1 ) && !uri.startsWith( "type="_L1 ) ) )
+                  {
+                    uri = xyzUri( uri, integer( p, u"zmin"_s, 0 ), integer( p, u"zmax"_s, 18 ) );
+                    provider = u"wms"_s;
+                  }
+
+                  if ( provider.isEmpty() )
+                  {
+                    // data file in the virtual filesystem: let the providers describe its sublayers (no dialogs)
+                    if ( !QFile::exists( uri.section( '|', 0, 0 ) ) )
+                      throw QgsWasmBridgeError( u"file not found: %1 (pass 'provider' for non-file data sources)"_s.arg( uri ) );
+                    const QList<QgsProviderSublayerDetails> sublayers = QgsProviderRegistry::instance()->querySublayers( uri, Qgis::SublayerQueryFlag::ResolveGeometryType );
+                    if ( sublayers.isEmpty() )
+                      throw QgsWasmBridgeError( u"no QGIS provider can read %1"_s.arg( uri ) );
+                    QList<QgsMapLayer *> layers;
+                    for ( const QgsProviderSublayerDetails &d : sublayers )
+                    {
+                      if ( !only.isEmpty() && d.name() != only )
+                        continue;
+                      if ( d.type() == Qgis::LayerType::Vector && d.wkbType() == Qgis::WkbType::Unknown && sublayers.size() > 1 )
+                        continue; // non-spatial tables of a multi-layer database are rarely wanted on the map
+                      QgsMapLayer *layer = d.toLayer( QgsProviderSublayerDetails::LayerOptions( QgsProject::instance()->transformContext() ) );
+                      if ( !layer )
+                        continue;
+                      if ( !name.isEmpty() && ( sublayers.size() == 1 || !only.isEmpty() ) )
+                        layer->setName( name );
+                      layers << layer;
+                    }
+                    if ( layers.isEmpty() )
+                      throw QgsWasmBridgeError( only.isEmpty() ? u"no usable layer in %1"_s.arg( uri ) : u"no sublayer named '%1' in %2"_s.arg( only, uri ) );
+                    added = QgsProject::instance()->addMapLayers( layers );
+                  }
+                  else
+                  {
+                    static const QStringList rasterProviders { u"gdal"_s, u"wms"_s, u"wcs"_s, u"arcgismapserver"_s };
+                    const QString baseName = name.isEmpty() ? QFileInfo( uri.section( '|', 0, 0 ) ).completeBaseName() : name;
+                    if ( rasterProviders.contains( provider ) )
+                    {
+                      if ( QgsRasterLayer *rl = app->addRasterLayer( uri, baseName.isEmpty() ? u"layer"_s : baseName, provider ) )
+                        added << rl;
+                    }
+                    else
+                    {
+                      if ( QgsVectorLayer *vl = app->addVectorLayer( uri, baseName.isEmpty() ? u"layer"_s : baseName, provider ) )
+                        added << vl;
+                    }
+                  }
+                  if ( added.isEmpty() )
+                    throw QgsWasmBridgeError( u"no layer could be added from %1"_s.arg( uri ) );
+                  QJsonArray a;
+                  for ( QgsMapLayer *l : std::as_const( added ) )
+                    a.append( layerToJson( l ) );
+                  return a;
+                } );
+
+  registerTool( u"layers_remove"_s, u"Remove a layer from the project."_s, schema( { { u"layer"_s, prop( u"string"_s, u"Layer id or name"_s ) } }, { u"layer"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+    QgsMapLayer *layer = resolveLayer( requireStr( p, u"layer"_s ) );
+    const QString id = layer->id();
+    QgsProject::instance()->removeMapLayer( id );
+    return QJsonObject { { u"removed"_s, id } };
+  } );
+
+  registerTool( u"layer_set_source"_s, u"Point an existing layer at another data source, keeping its id, name, style and position in the layer tree — e.g. after its file was copied to a cloud mount, or to reload a query result that was rewritten in place. Same provider unless 'provider' is given."_s,
+                schema( { { u"layer"_s, prop( u"string"_s, u"Layer id or name"_s ) }, { u"source"_s, prop( u"string"_s, u"New data source URI, e.g. /cloud/shared/projects/<id>/data/a.geojson|layername=a"_s ) }, { u"provider"_s, prop( u"string"_s, u"Provider key (optional, default: the layer's current provider)"_s ) } }, { u"layer"_s, u"source"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+                  QgsMapLayer *layer = resolveLayer( requireStr( p, u"layer"_s ) );
+                  const QString source = requireStr( p, u"source"_s );
+                  const QString provider = str( p, u"provider"_s, layer->providerType() );
+                  layer->setDataSource( source, layer->name(), provider, QgsDataProvider::ProviderOptions() );
+                  if ( !layer->isValid() )
+                    throw QgsWasmBridgeError( u"layer %1 is not valid with source %2"_s.arg( layer->name(), source ) );
+                  layer->triggerRepaint();
+                  return layerToJson( layer );
+                } );
+
+  registerTool( u"layers_set_visible"_s, u"Show or hide a layer (layer tree checkbox)."_s,
+                schema( { { u"layer"_s, prop( u"string"_s, u"Layer id or name"_s ) }, { u"visible"_s, prop( u"boolean"_s, u"true to show, false to hide"_s ) } }, { u"layer"_s, u"visible"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+                  QgsMapLayer *layer = resolveLayer( requireStr( p, u"layer"_s ) );
+                  QgsLayerTreeLayer *node = QgsProject::instance()->layerTreeRoot()->findLayer( layer->id() );
+                  if ( !node )
+                    throw QgsWasmBridgeError( u"layer is not in the layer tree"_s );
+                  node->setItemVisibilityChecked( flag( p, u"visible"_s, true ) );
+                  return layerToJson( layer );
+                } );
+
+  registerTool( u"layers_zoom_to"_s, u"Zoom the map canvas to the extent of a layer."_s, schema( { { u"layer"_s, prop( u"string"_s, u"Layer id or name"_s ) } }, { u"layer"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+    QgsMapLayer *layer = resolveLayer( requireStr( p, u"layer"_s ) );
+    QgsMapCanvas *canvas = QgisApp::instance()->mapCanvas();
+    QgsRectangle extent = canvas->mapSettings().layerExtentToOutputExtent( layer, layer->extent() );
+    if ( extent.isEmpty() )
+      extent.grow( 1 );
+    canvas->setExtent( extent );
+    canvas->refresh();
+    return rectToJson( canvas->extent(), canvas->mapSettings().destinationCrs().authid() );
+  } );
+
+  registerTool( u"layer_fields"_s, u"Fields (attributes) of a vector layer with their types."_s, schema( { { u"layer"_s, prop( u"string"_s, u"Layer id or name"_s ) } }, { u"layer"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+    QgsVectorLayer *vl = requireVectorLayer( requireStr( p, u"layer"_s ) );
+    QJsonArray a;
+    const QgsFields fields = vl->fields();
+    for ( const QgsField &f : fields )
+      a.append( QJsonObject { { u"name"_s, f.name() }, { u"type"_s, f.typeName() }, { u"length"_s, f.length() }, { u"alias"_s, f.alias() } } );
+    return a;
+  } );
+
+  registerTool( u"layer_features"_s, u"Read features of a vector layer as GeoJSON (optionally filtered by a QGIS expression, limited, selected-only, with or without geometry). Default limit 50."_s,
+                schema( { { u"layer"_s, prop( u"string"_s, u"Layer id or name"_s ) },
+                          { u"expression"_s, prop( u"string"_s, u"QGIS filter expression, e.g. \"POP_EST\" > 1000000 (optional)"_s ) },
+                          { u"limit"_s, prop( u"integer"_s, u"Maximum number of features (default 50)"_s ) },
+                          { u"selected"_s, prop( u"boolean"_s, u"Only the currently selected features"_s ) },
+                          { u"geometry"_s, prop( u"boolean"_s, u"Include geometries (default false; geometries can be large)"_s ) },
+                          { u"fields"_s, arrayProp( u"string"_s, u"Only these fields (optional)"_s ) } },
+                        { u"layer"_s } ),
+                []( const QJsonObject &p ) -> QJsonValue {
+                  QgsVectorLayer *vl = requireVectorLayer( requireStr( p, u"layer"_s ) );
+                  const bool withGeometry = flag( p, u"geometry"_s, false );
+                  QgsFeatureRequest request;
+                  const QString expression = str( p, u"expression"_s );
+                  if ( !expression.isEmpty() )
+                    request.setFilterExpression( expression );
