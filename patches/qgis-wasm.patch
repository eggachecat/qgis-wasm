+  QJsonObject symbolToJson( const QgsSymbol *symbol )
+  {
+    QJsonObject o;
+    if ( !symbol )
+      return o;
+    switch ( symbol->type() )
+    {
+      case Qgis::SymbolType::Marker: o[u"type"_s] = u"marker"_s; break;
+      case Qgis::SymbolType::Line: o[u"type"_s] = u"line"_s; break;
+      case Qgis::SymbolType::Fill: o[u"type"_s] = u"fill"_s; break;
+      case Qgis::SymbolType::Hybrid: o[u"type"_s] = u"hybrid"_s; break;
+    }
+    o[u"color"_s] = colorStr( symbol->color() );
+    o[u"opacity"_s] = symbol->opacity();
+    o[u"layers"_s] = symbol->symbolLayerCount();
+    const QgsSymbolLayer *layer = symbol->symbolLayerCount() ? symbol->symbolLayer( 0 ) : nullptr;
+    if ( const QgsSimpleMarkerSymbolLayer *m = dynamic_cast<const QgsSimpleMarkerSymbolLayer *>( layer ) )
+    {
+      o[u"shape"_s] = QgsSimpleMarkerSymbolLayerBase::encodeShape( m->shape() );
+      o[u"size"_s] = m->size();
+      o[u"stroke_color"_s] = colorStr( m->strokeColor() );
+      o[u"stroke_width"_s] = m->strokeWidth();
+      o[u"stroke_style"_s] = QgsSymbolLayerUtils::encodePenStyle( m->strokeStyle() );
+    }
+    else if ( const QgsSimpleLineSymbolLayer *l = dynamic_cast<const QgsSimpleLineSymbolLayer *>( layer ) )
+    {
+      o[u"width"_s] = l->width();
+      o[u"stroke_style"_s] = QgsSymbolLayerUtils::encodePenStyle( l->penStyle() );
+    }
+    else if ( const QgsSimpleFillSymbolLayer *f = dynamic_cast<const QgsSimpleFillSymbolLayer *>( layer ) )
+    {
+      o[u"stroke_color"_s] = colorStr( f->strokeColor() );
+      o[u"stroke_width"_s] = f->strokeWidth();
+      o[u"stroke_style"_s] = QgsSymbolLayerUtils::encodePenStyle( f->strokeStyle() );
+      o[u"fill_style"_s] = QgsSymbolLayerUtils::encodeBrushStyle( f->brushStyle() );
+    }
+    else if ( layer )
+      o[u"layer_type"_s] = layer->layerType();
+    return o;
+  }
