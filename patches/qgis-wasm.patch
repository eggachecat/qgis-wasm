+                                                 { u"destination"_s, d->isDestination() }, { u"default"_s, variantToJson( d->defaultValue() ) } } );
+                  }
+                  QJsonArray outputs;
+                  const QgsProcessingOutputDefinitions outs = alg->outputDefinitions();
+                  for ( const QgsProcessingOutputDefinition *o : outs )
+                    outputs.append( QJsonObject { { u"name"_s, o->name() }, { u"type"_s, o->type() }, { u"description"_s, o->description() } } );
+                  return QJsonObject { { u"id"_s, alg->id() }, { u"name"_s, alg->displayName() }, { u"group"_s, alg->group() }, { u"help"_s, alg->shortHelpString() }, { u"parameters"_s, params }, { u"outputs"_s, outputs } };
+                } );
+
+  registerTool( u"processing_run"_s, u"Run a Processing algorithm. Layer parameters accept layer ids/names or file paths; destination parameters default to temporary (memory) outputs which are added to the project. Returns the algorithm results and the added layers."_s,
+                schema( { { u"algorithm"_s, prop( u"string"_s, u"Algorithm id, e.g. native:buffer"_s ) },
+                          { u"parameters"_s, QJsonObject { { u"type"_s, u"object"_s }, { u"description"_s, u"Parameter name → value (see processing_describe)"_s } } },
+                          { u"add_to_project"_s, prop( u"boolean"_s, u"Add result layers to the project (default true)"_s ) } },
+                        { u"algorithm"_s } ),
+                []( const QJsonObject &p ) -> QJsonValue {
+                  const QString id = requireStr( p, u"algorithm"_s );
+                  std::unique_ptr<QgsProcessingAlgorithm> alg( QgsApplication::processingRegistry()->createAlgorithmById( id ) );
+                  if ( !alg )
+                    throw QgsWasmBridgeError( u"unknown algorithm '%1'"_s.arg( id ) );
+                  QVariantMap parameters = p.value( u"parameters"_s ).toObject().toVariantMap();
+                  const bool addToProject = flag( p, u"add_to_project"_s, true );
+                  const QgsProcessingParameterDefinitions defs = alg->parameterDefinitions();
+                  for ( const QgsProcessingParameterDefinition *d : defs )
+                  {
+                    if ( !d->isDestination() )
+                      continue;
+                    QString sink = parameters.value( d->name() ).toString();
+                    // file / folder destinations (native:savefeatures, native:package, exports) are read by the algorithm
+                    // with parameterAsString(): they take a plain path — wrapped in an output layer definition they came out
+                    // empty ("Could not create layer : Empty filename given")
+                    if ( d->type() == QgsProcessingParameterFileDestination::typeName() || d->type() == QgsProcessingParameterFolderDestination::typeName() )
+                    {
+                      if ( sink.isEmpty() )
+                        sink = static_cast<const QgsProcessingDestinationParameter *>( d )->generateTemporaryDestination();
+                      parameters.insert( d->name(), sink );
+                      continue;
+                    }
+                    // like the Processing dialog: layer destinations default to temporary layers and are flagged for loading
+                    if ( sink.isEmpty() )
+                      sink = QgsProcessing::TEMPORARY_OUTPUT;
+                    QgsProcessingOutputLayerDefinition definition( sink, addToProject ? QgsProject::instance() : nullptr );
+                    parameters.insert( d->name(), QVariant::fromValue( definition ) );
+                  }
+                  QgsProcessingContext context;
+                  context.setProject( QgsProject::instance() );
+                  context.setTransformContext( QgsProject::instance()->transformContext() );
+                  QgsProcessingFeedback feedback( false );
+                  QString message;
+                  if ( !alg->checkParameterValues( parameters, context, &message ) )
+                    throw QgsWasmBridgeError( u"invalid parameters: %1"_s.arg( message ) );
+                  bool ok = false;
+                  const QVariantMap results = alg->run( parameters, context, &feedback, &ok );
+                  if ( !ok )
+                    throw QgsWasmBridgeError( u"algorithm failed: %1"_s.arg( feedback.textLog().right( 2000 ) ) );
+                  QJsonArray added;
+                  if ( addToProject )
+                  {
+                    const QMap<QString, QgsProcessingContext::LayerDetails> toLoad = context.layersToLoadOnCompletion();
+                    for ( auto it = toLoad.constBegin(); it != toLoad.constEnd(); ++it )
+                    {
+                      QgsMapLayer *layer = context.takeResultLayer( it.key() );
+                      if ( !layer )
+                        continue;
+                      if ( !it.value().name.isEmpty() )
+                        layer->setName( it.value().name );
+                      QgsProject::instance()->addMapLayer( layer );
+                      added.append( layerToJson( layer ) );
+                    }
+                  }
+                  return QJsonObject { { u"results"_s, QJsonObject::fromVariantMap( results ) }, { u"layers"_s, added }, { u"log"_s, feedback.textLog().right( 4000 ) } };
+                } );
+
+  // ---------------------------------------------------------------- settings & basemaps
+  registerTool( u"settings_get"_s, u"Read a QGIS setting (user profile), e.g. qgis/checkVersion or connections/xyz/items/OpenStreetMap/url."_s, schema( { { u"key"_s, prop( u"string"_s, u"Setting key"_s ) } }, { u"key"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+    QgsSettings settings;
+    return variantToJson( settings.value( requireStr( p, u"key"_s ) ) );
