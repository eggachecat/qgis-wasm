+                  return QJsonObject { { u"path"_s, path }, { u"size"_s, data.size() } };
+                } );
+
+  registerTool( u"files_download"_s, u"Download an http(s) URL into the virtual filesystem (default /home/web_user/downloads/<name>) and return the local path."_s,
