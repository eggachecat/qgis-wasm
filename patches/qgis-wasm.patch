+  //! A colour ramp from "Viridis" (a name of the default style), "random", ["#fee", "#900"], or {name, invert}
+  std::unique_ptr<QgsColorRamp> rampFromJson( const QJsonValue &v )
+  {
+    if ( v.isUndefined() || v.isNull() )
+      return nullptr;
+    QString name;
+    bool invert = false;
+    QJsonArray colors;
+    if ( v.isString() )
+      name = v.toString();
+    else if ( v.isArray() )
+      colors = v.toArray();
+    else if ( v.isObject() )
+    {
+      name = v.toObject().value( u"name"_s ).toString();
+      invert = v.toObject().value( u"invert"_s ).toBool();
+      colors = v.toObject().value( u"colors"_s ).toArray();
+    }
+    std::unique_ptr<QgsColorRamp> ramp;
+    if ( !colors.isEmpty() )
+    {
+      if ( colors.size() == 1 )
+      {
+        const QColor c = parseColor( colors.first().toString() );
+        ramp.reset( new QgsGradientColorRamp( c, c ) );
+      }
+      else
+      {
+        QgsGradientStopsList stops;
+        for ( int i = 1; i < colors.size() - 1; ++i )
+          stops << QgsGradientStop( static_cast<double>( i ) / ( colors.size() - 1 ), parseColor( colors.at( i ).toString() ) );
+        ramp.reset( new QgsGradientColorRamp( parseColor( colors.first().toString() ), parseColor( colors.last().toString() ), false, stops ) );
+      }
+    }
+    else if ( !name.isEmpty() )
+    {
+      if ( name.compare( "random"_L1, Qt::CaseInsensitive ) == 0 )
+        ramp.reset( new QgsLimitedRandomColorRamp() );
+      else
+      {
+        QgsStyle *style = QgsStyle::defaultStyle();
+        ramp.reset( style->colorRamp( name ) );
+        if ( !ramp )
+        {
+          const QStringList names = style->colorRampNames();
+          for ( const QString &n : names )
+            if ( n.compare( name, Qt::CaseInsensitive ) == 0 )
+            {
+              ramp.reset( style->colorRamp( n ) );
+              break;
+            }
+          if ( !ramp )
+            throw QgsWasmBridgeError( u"unknown colour ramp '%1'; available: %2 — or give a list of colours"_s.arg( name, names.join( ", "_L1 ) ) );
+        }
+      }
+    }
+    if ( ramp && invert )
+      ramp->invert();
+    return ramp;
+  }
