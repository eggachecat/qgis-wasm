+  QJsonObject labelsToJson( QgsVectorLayer *vl )
+  {
+    QJsonObject o;
+    const QgsAbstractVectorLayerLabeling *labeling = vl->labeling();
+    o[u"enabled"_s] = vl->labelsEnabled() && labeling;
+    if ( !labeling )
+      return o;
+    o[u"type"_s] = labeling->type();
+    const QgsPalLayerSettings s = labeling->settings();
+    o[s.isExpression ? u"expression"_s : u"field"_s] = s.fieldName;
+    QgsTextFormat f = s.format();
+    o[u"size"_s] = f.size();
+    o[u"size_unit"_s] = unitToString( f.sizeUnit() );
+    o[u"color"_s] = colorStr( f.color() );
+    o[u"opacity"_s] = f.opacity();
+    o[u"font"_s] = f.font().family();
+    o[u"bold"_s] = f.font().bold() || f.forcedBold();
+    o[u"italic"_s] = f.font().italic() || f.forcedItalic();
+    o[u"buffer"_s] = QJsonObject { { u"enabled"_s, f.buffer().enabled() }, { u"size"_s, f.buffer().size() }, { u"color"_s, colorStr( f.buffer().color() ) } };
+    o[u"background"_s] = QJsonObject { { u"enabled"_s, f.background().enabled() }, { u"fill_color"_s, colorStr( f.background().fillColor() ) }, { u"stroke_color"_s, colorStr( f.background().strokeColor() ) } };
+    o[u"placement"_s] = placementToString( s.placement );
+    o[u"priority"_s] = s.priority;
+    o[u"distance"_s] = s.dist;
+    o[u"offset"_s] = QJsonArray { s.xOffset, s.yOffset };
+    switch ( s.placementSettings().overlapHandling() )
+    {
+      case Qgis::LabelOverlapHandling::PreventOverlap: o[u"overlap"_s] = u"prevent"_s; break;
+      case Qgis::LabelOverlapHandling::AllowOverlapIfRequired: o[u"overlap"_s] = u"allow_if_required"_s; break;
+      case Qgis::LabelOverlapHandling::AllowOverlapAtNoCost: o[u"overlap"_s] = u"allow"_s; break;
+    }
+    if ( s.scaleVisibility )
+    {
+      o[u"min_scale"_s] = s.minimumScale;
+      o[u"max_scale"_s] = s.maximumScale;
+    }
+    if ( !s.wrapChar.isEmpty() )
+      o[u"wrap_char"_s] = s.wrapChar;
+    if ( s.autoWrapLength > 0 )
+      o[u"wrap_length"_s] = s.autoWrapLength;
+    return o;
+  }
+
+  //! Applies a labels JSON (see layer_style_set) on top of the layer's current label settings
+  void applyLabels( QgsVectorLayer *vl, const QJsonObject &j )
+  {
+    if ( j.contains( u"enabled"_s ) && !flag( j, u"enabled"_s, true ) )
+    {
+      vl->setLabelsEnabled( false ); // the settings stay for a later "enabled": true
+      return;
+    }
+    QgsPalLayerSettings s = vl->labeling() ? vl->labeling()->settings() : QgsPalLayerSettings();
+    const bool fresh = !vl->labeling();
+    if ( j.contains( u"expression"_s ) )
+    {
+      s.fieldName = str( j, u"expression"_s );
+      s.isExpression = true;
+    }
+    else if ( j.contains( u"field"_s ) )
+    {
+      s.fieldName = str( j, u"field"_s );
+      s.isExpression = vl->fields().lookupField( s.fieldName ) < 0;
+    }
+    if ( s.fieldName.isEmpty() )
+      throw QgsWasmBridgeError( u"labels need 'field' (a field name) or 'expression'"_s );
+    QgsTextFormat f = s.format();
+    if ( fresh )
+    {
+      f.setSize( 10 );
+      f.setSizeUnit( Qgis::RenderUnit::Points );
+    }
+    if ( j.contains( u"size"_s ) )
+      f.setSize( num( j, u"size"_s, 10 ) );
+    if ( j.contains( u"size_unit"_s ) )
+      f.setSizeUnit( unitFromString( str( j, u"size_unit"_s ), Qgis::RenderUnit::Points ) );
+    if ( j.contains( u"color"_s ) )
+      f.setColor( parseColor( str( j, u"color"_s ) ) );
+    if ( j.contains( u"opacity"_s ) )
+      f.setOpacity( std::clamp( num( j, u"opacity"_s, 1.0 ), 0.0, 1.0 ) );
+    if ( j.contains( u"font"_s ) || j.contains( u"bold"_s ) || j.contains( u"italic"_s ) )
+    {
+      QFont font = f.font();
+      if ( !str( j, u"font"_s ).isEmpty() )
+        font.setFamily( str( j, u"font"_s ) );
+      if ( j.contains( u"bold"_s ) )
+      {
+        font.setBold( flag( j, u"bold"_s, false ) );
+        f.setForcedBold( flag( j, u"bold"_s, false ) );
+      }
+      if ( j.contains( u"italic"_s ) )
+      {
+        font.setItalic( flag( j, u"italic"_s, false ) );
+        f.setForcedItalic( flag( j, u"italic"_s, false ) );
+      }
+      f.setFont( font );
+    }
+    if ( j.contains( u"buffer"_s ) )
+    {
+      const QJsonValue bv = j.value( u"buffer"_s );
+      QgsTextBufferSettings b = f.buffer();
+      if ( bv.isBool() )
+        b.setEnabled( bv.toBool() );
+      else if ( bv.isDouble() )
+      {
+        b.setEnabled( bv.toDouble() > 0 );
+        b.setSize( bv.toDouble() );
+      }
+      else
+      {
+        const QJsonObject bo = bv.toObject();
+        b.setEnabled( flag( bo, u"enabled"_s, true ) );
+        if ( bo.contains( u"size"_s ) )
+          b.setSize( num( bo, u"size"_s, 1 ) );
+        if ( bo.contains( u"color"_s ) )
+          b.setColor( parseColor( str( bo, u"color"_s ) ) );
+        if ( bo.contains( u"opacity"_s ) )
+          b.setOpacity( std::clamp( num( bo, u"opacity"_s, 1.0 ), 0.0, 1.0 ) );
+      }
+      f.setBuffer( b );
+    }
+    if ( j.contains( u"background"_s ) )
+    {
+      const QJsonValue bv = j.value( u"background"_s );
+      QgsTextBackgroundSettings b = f.background();
+      const bool wasEnabled = b.enabled();
+      if ( bv.isBool() )
+        b.setEnabled( bv.toBool() );
+      else
+      {
+        const QJsonObject bo = bv.toObject();
+        b.setEnabled( flag( bo, u"enabled"_s, true ) );
+        if ( bo.contains( u"fill_color"_s ) || bo.contains( u"color"_s ) )
+          b.setFillColor( parseColor( str( bo, bo.contains( u"fill_color"_s ) ? u"fill_color"_s : u"color"_s ) ) );
+        if ( bo.contains( u"stroke_color"_s ) )
+          b.setStrokeColor( parseColor( str( bo, u"stroke_color"_s ) ) );
+        if ( bo.contains( u"stroke_width"_s ) )
+          b.setStrokeWidth( num( bo, u"stroke_width"_s, 0 ) );
+        if ( bo.contains( u"radius"_s ) )
+          b.setRadii( QSizeF( num( bo, u"radius"_s, 0 ), num( bo, u"radius"_s, 0 ) ) );
+        if ( bo.contains( u"opacity"_s ) )
+          b.setOpacity( std::clamp( num( bo, u"opacity"_s, 1.0 ), 0.0, 1.0 ) );
+      }
+      if ( b.enabled() && !wasEnabled && b.size().isNull() )
+      {
+        b.setSizeType( QgsTextBackgroundSettings::SizeBuffer );
+        b.setSize( QSizeF( 1, 0.5 ) );
+      }
+      f.setBackground( b );
+    }
+    if ( j.contains( u"placement"_s ) )
+      s.placement = placementFromString( str( j, u"placement"_s ) );
+    if ( j.contains( u"priority"_s ) )
+      s.priority = std::clamp( integer( j, u"priority"_s, 5 ), 0, 10 );
+    if ( j.contains( u"distance"_s ) )
+    {
+      s.dist = num( j, u"distance"_s, 0 );
+      s.distUnits = Qgis::RenderUnit::Millimeters;
+    }
+    if ( j.value( u"offset"_s ).isArray() )
+    {
+      const QJsonArray off = j.value( u"offset"_s ).toArray();
+      s.xOffset = off.size() > 0 ? off.at( 0 ).toDouble() : 0;
+      s.yOffset = off.size() > 1 ? off.at( 1 ).toDouble() : 0;
+      s.offsetUnits = Qgis::RenderUnit::Millimeters;
+      s.offsetType = Qgis::LabelOffsetType::FromPoint;
+      if ( !j.contains( u"placement"_s ) && vl->geometryType() == Qgis::GeometryType::Point )
+        s.placement = Qgis::LabelPlacement::OverPoint;
+    }
+    if ( j.contains( u"overlap"_s ) )
+    {
+      const QString o = str( j, u"overlap"_s ).toLower();
+      s.placementSettings().setOverlapHandling( o == "prevent"_L1 ? Qgis::LabelOverlapHandling::PreventOverlap : o == "allow"_L1 || o == "always"_L1 ? Qgis::LabelOverlapHandling::AllowOverlapAtNoCost : Qgis::LabelOverlapHandling::AllowOverlapIfRequired );
+    }
+    if ( j.contains( u"show_all"_s ) )
+    {
+      const bool all = flag( j, u"show_all"_s, false );
+      s.placementSettings().setOverlapHandling( all ? Qgis::LabelOverlapHandling::AllowOverlapAtNoCost : Qgis::LabelOverlapHandling::PreventOverlap );
+      s.placementSettings().setAllowDegradedPlacement( all );
+    }
+    if ( j.contains( u"min_scale"_s ) || j.contains( u"max_scale"_s ) )
+    {
+      s.minimumScale = num( j, u"min_scale"_s, s.minimumScale );
+      s.maximumScale = num( j, u"max_scale"_s, s.maximumScale );
+      s.scaleVisibility = s.minimumScale > 0 || s.maximumScale > 0;
+    }
+    if ( j.contains( u"wrap_char"_s ) )
+      s.wrapChar = str( j, u"wrap_char"_s );
+    if ( j.contains( u"wrap_length"_s ) )
+      s.autoWrapLength = integer( j, u"wrap_length"_s, 0 );
+    if ( j.contains( u"align"_s ) )
+    {
+      const QString a = str( j, u"align"_s ).toLower();
+      s.multilineAlign = a == "left"_L1 ? Qgis::LabelMultiLineAlignment::Left : a == "right"_L1 ? Qgis::LabelMultiLineAlignment::Right : a == "center"_L1 || a == "centre"_L1 ? Qgis::LabelMultiLineAlignment::Center : a == "justify"_L1 ? Qgis::LabelMultiLineAlignment::Justify : Qgis::LabelMultiLineAlignment::FollowPlacement;
+    }
+    s.setFormat( f );
+    s.drawLabels = true;
+    vl->setLabeling( new QgsVectorLayerSimpleLabeling( s ) );
+    vl->setLabelsEnabled( true );
+  }
+
+  QJsonObject rendererToJson( QgsVectorLayer *vl )
+  {
+    QJsonObject o;
+    QgsFeatureRenderer *r = vl->renderer();
+    if ( !r )
+      return o;
+    const QString t = r->type();
+    if ( t == "singleSymbol"_L1 )
+    {
+      o[u"type"_s] = u"single"_s;
+      o[u"symbol"_s] = symbolToJson( static_cast<QgsSingleSymbolRenderer *>( r )->symbol() );
+    }
+    else if ( t == "categorizedSymbol"_L1 )
+    {
+      QgsCategorizedSymbolRenderer *c = static_cast<QgsCategorizedSymbolRenderer *>( r );
+      o[u"type"_s] = u"categorized"_s;
+      o[u"field"_s] = c->classAttribute();
+      if ( c->sourceSymbol() )
+        o[u"symbol"_s] = symbolToJson( c->sourceSymbol() );
+      QJsonArray cats;
+      const QgsCategoryList list = c->categories();
+      for ( const QgsRendererCategory &cat : list )
+        cats.append( QJsonObject { { u"value"_s, QgsWasmBridge::variantToJson( cat.value() ) }, { u"label"_s, cat.label() }, { u"color"_s, cat.symbol() ? colorStr( cat.symbol()->color() ) : QString() }, { u"enabled"_s, cat.renderState() } } );
+      o[u"categories"_s] = cats;
+    }
+    else if ( t == "graduatedSymbol"_L1 )
+    {
+      QgsGraduatedSymbolRenderer *g = static_cast<QgsGraduatedSymbolRenderer *>( r );
+      o[u"type"_s] = u"graduated"_s;
+      o[u"field"_s] = g->classAttribute();
+      if ( g->sourceSymbol() )
+        o[u"symbol"_s] = symbolToJson( g->sourceSymbol() );
+      if ( g->classificationMethod() )
+        o[u"mode"_s] = classificationModeToString( g->classificationMethod()->id() );
+      QJsonArray ranges;
+      for ( const QgsRendererRange &rg : g->ranges() )
+        ranges.append( QJsonObject { { u"lower"_s, rg.lowerValue() }, { u"upper"_s, rg.upperValue() }, { u"label"_s, rg.label() }, { u"color"_s, rg.symbol() ? colorStr( rg.symbol()->color() ) : QString() }, { u"enabled"_s, rg.renderState() } } );
+      o[u"ranges"_s] = ranges;
+    }
+    else
+      o[u"type"_s] = t;
+    return o;
+  }
+
+  //! Replaces the renderer from a renderer JSON (see layer_style_set); the current symbol is the starting point
+  void applyRenderer( QgsVectorLayer *vl, const QJsonObject &j )
+  {
+    QgsFeatureRenderer *current = vl->renderer();
+    const QString currentType = current ? current->type() : QString();
+    QString type = str( j, u"type"_s ).toLower();
+    if ( type.isEmpty() )
+    {
+      if ( j.contains( u"ranges"_s ) || j.contains( u"classes"_s ) || j.contains( u"mode"_s ) )
+        type = u"graduated"_s;
+      else if ( j.contains( u"categories"_s ) || j.contains( u"field"_s ) )
+        type = u"categorized"_s;
+      else if ( currentType == "categorizedSymbol"_L1 )
+        type = u"categorized"_s;
+      else if ( currentType == "graduatedSymbol"_L1 )
+        type = u"graduated"_s;
+      else
+        type = u"single"_s;
+    }
+    const QgsSymbol *baseSymbol = nullptr;
+    QString currentField;
+    if ( currentType == "singleSymbol"_L1 )
+      baseSymbol = static_cast<QgsSingleSymbolRenderer *>( current )->symbol();
+    else if ( currentType == "categorizedSymbol"_L1 )
+    {
+      baseSymbol = static_cast<QgsCategorizedSymbolRenderer *>( current )->sourceSymbol();
+      currentField = static_cast<QgsCategorizedSymbolRenderer *>( current )->classAttribute();
+    }
+    else if ( currentType == "graduatedSymbol"_L1 )
+    {
+      baseSymbol = static_cast<QgsGraduatedSymbolRenderer *>( current )->sourceSymbol();
+      currentField = static_cast<QgsGraduatedSymbolRenderer *>( current )->classAttribute();
+    }
+    std::unique_ptr<QgsSymbol> symbol = symbolFromJson( vl->geometryType(), j.value( u"symbol"_s ).toObject(), baseSymbol );
+    if ( type == "single"_L1 || type == "singlesymbol"_L1 )
+    {
+      vl->setRenderer( new QgsSingleSymbolRenderer( symbol.release() ) );
+      return;
+    }
+    const QString field = str( j, u"field"_s, currentField );
+    if ( field.isEmpty() )
+      throw QgsWasmBridgeError( u"a %1 renderer needs 'field' (a field name or an expression)"_s.arg( type ) );
+    std::unique_ptr<QgsColorRamp> ramp = rampFromJson( j.value( u"ramp"_s ) );
+    const int fieldIndex = vl->fields().lookupField( field );
+    if ( type == "categorized"_L1 )
+    {
+      QgsCategoryList cats;
+      bool explicitColors = false;
+      if ( j.value( u"categories"_s ).isArray() )
+      {
+        const QJsonArray given = j.value( u"categories"_s ).toArray();
+        for ( const QJsonValue &cv : given )
+        {
+          const QJsonObject co = cv.toObject();
+          std::unique_ptr<QgsSymbol> sym = symbolFromJson( vl->geometryType(), co.value( u"symbol"_s ).toObject(), symbol.get() );
+          if ( co.contains( u"color"_s ) )
+          {
+            sym->setColor( parseColor( str( co, u"color"_s ) ) );
+            explicitColors = true;
+          }
+          const QVariant value = co.value( u"value"_s ).toVariant();
+          cats << QgsRendererCategory( value, sym.release(), str( co, u"label"_s, value.toString() ), flag( co, u"enabled"_s, true ) );
+        }
+      }
+      else
+      {
+        QVariantList values;
+        if ( fieldIndex >= 0 )
+        {
+          const QSet<QVariant> unique = vl->uniqueValues( fieldIndex, 2000 );
+          values = QVariantList( unique.begin(), unique.end() );
+          std::sort( values.begin(), values.end(), qgsVariantLessThan );
+        }
+        else
+        {
+          bool ok = false;
+          const QVariantList all = QgsVectorLayerUtils::getValues( vl, field, ok );
+          if ( !ok )
+            throw QgsWasmBridgeError( u"'%1' is neither a field of the layer nor a valid expression"_s.arg( field ) );
+          QSet<QString> seen;
+          for ( const QVariant &v : all )
+          {
+            if ( seen.contains( v.toString() ) )
+              continue;
+            seen.insert( v.toString() );
+            values << v;
+            if ( values.size() >= 2000 )
+              break;
+          }
+        }
+        cats = QgsCategorizedSymbolRenderer::createCategories( values, symbol.get(), vl, fieldIndex >= 0 ? field : QString() );
+      }
+      QgsCategorizedSymbolRenderer *r = new QgsCategorizedSymbolRenderer( field, cats );
+      r->setSourceSymbol( symbol->clone() );
+      if ( !explicitColors )
+      {
+        if ( !ramp )
+          ramp.reset( cats.size() <= 9 ? static_cast<QgsColorRamp *>( new QgsColorBrewerColorRamp( u"Set1"_s, std::max( 3, static_cast<int>( cats.size() ) ) ) ) : cats.size() <= 12 ? static_cast<QgsColorRamp *>( new QgsColorBrewerColorRamp( u"Paired"_s, static_cast<int>( cats.size() ) ) ) : static_cast<QgsColorRamp *>( new QgsLimitedRandomColorRamp( static_cast<int>( cats.size() ) ) ) );
+        r->updateColorRamp( ramp.release() );
+      }
+      else if ( ramp )
+        r->setSourceColorRamp( ramp.release() );
+      vl->setRenderer( r );
+    }
+    else if ( type == "graduated"_L1 )
+    {
+      QgsGraduatedSymbolRenderer *r = new QgsGraduatedSymbolRenderer( field );
+      r->setSourceSymbol( symbol->clone() );
+      if ( !ramp )
+      {
+        ramp.reset( QgsStyle::defaultStyle()->colorRamp( u"Viridis"_s ) );
+        if ( !ramp )
+          ramp.reset( new QgsGradientColorRamp( QColor( u"#fef0d9"_s ), QColor( u"#b30000"_s ) ) );
+      }
+      r->setSourceColorRamp( ramp.release() );
+      bool explicitColors = false;
+      if ( j.value( u"ranges"_s ).isArray() )
+      {
+        const QJsonArray given = j.value( u"ranges"_s ).toArray();
+        for ( const QJsonValue &rv : given )
+        {
+          const QJsonObject ro = rv.toObject();
+          std::unique_ptr<QgsSymbol> sym = symbolFromJson( vl->geometryType(), ro.value( u"symbol"_s ).toObject(), symbol.get() );
+          if ( ro.contains( u"color"_s ) )
+          {
+            sym->setColor( parseColor( str( ro, u"color"_s ) ) );
+            explicitColors = true;
+          }
+          const double lower = num( ro, u"lower"_s, 0 ), upper = num( ro, u"upper"_s, 0 );
+          r->addClass( QgsRendererRange( lower, upper, sym.release(), str( ro, u"label"_s, u"%1 - %2"_s.arg( lower ).arg( upper ) ) ) );
+        }
+      }
+      else
+      {
+        if ( fieldIndex >= 0 && !vl->fields().at( fieldIndex ).isNumeric() )
+        {
+          delete r;
+          throw QgsWasmBridgeError( u"'%1' is a %2 field: graduated classes need a numeric field or expression (a categorized renderer works for text)"_s.arg( field, vl->fields().at( fieldIndex ).typeName() ) );
+        }
+        std::unique_ptr<QgsClassificationMethod> method = QgsApplication::classificationMethodRegistry()->method( classificationModeFromString( str( j, u"mode"_s ) ) );
+        if ( !method )
+          throw QgsWasmBridgeError( u"classification mode not available: %1"_s.arg( str( j, u"mode"_s ) ) );
+        r->setClassificationMethod( method.release() );
+        QString error;
+        r->updateClasses( vl, std::clamp( integer( j, u"classes"_s, 5 ), 1, 50 ), error );
+        if ( r->ranges().isEmpty() )
+        {
+          delete r;
+          throw QgsWasmBridgeError( u"no classes for '%1': %2"_s.arg( field, error.isEmpty() ? u"is it numeric?"_s : error ) );
+        }
+      }
+      if ( !explicitColors )
+        r->updateColorRamp( nullptr );
+      vl->setRenderer( r );
+    }
+    else
+      throw QgsWasmBridgeError( u"renderer type must be single, categorized or graduated (got '%1')"_s.arg( type ) );
+  }
+
+  QJsonObject styleToJson( QgsMapLayer *layer )
+  {
+    QJsonObject o { { u"layer"_s, layer->id() }, { u"name"_s, layer->name() }, { u"opacity"_s, layer->opacity() } };
+    if ( layer->hasScaleBasedVisibility() )
+    {
+      o[u"min_scale"_s] = layer->minimumScale();
+      o[u"max_scale"_s] = layer->maximumScale();
+    }
+    if ( QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer ) )
+    {
+      o[u"geometry"_s] = QgsWkbTypes::geometryDisplayString( vl->geometryType() );
+      o[u"renderer"_s] = rendererToJson( vl );
+      o[u"labels"_s] = labelsToJson( vl );
+    }
+    else if ( QgsRasterLayer *rl = qobject_cast<QgsRasterLayer *>( layer ) )
+      o[u"renderer"_s] = QJsonObject { { u"type"_s, rl->renderer() ? rl->renderer()->type() : QString() } };
+    return o;
+  }
+
+  //! After a style change: repaint the canvas and refresh the legend entry
+  void refreshStyle( QgsMapLayer *layer )
+  {
+    layer->triggerRepaint();
+    layer->emitStyleChanged();
+    if ( QgisApp::instance() && QgisApp::instance()->layerTreeView() )
+      QgisApp::instance()->layerTreeView()->refreshLayerSymbology( layer->id() );
+  }
+
+  QJsonObject projectInfo()
+  {
+    QgsProject *project = QgsProject::instance();
+    QgsMapCanvas *canvas = QgisApp::instance()->mapCanvas();
+    QJsonObject o;
+    o[u"file"_s] = project->fileName();
+    o[u"title"_s] = project->title();
+    o[u"crs"_s] = project->crs().authid();
+    o[u"dirty"_s] = project->isDirty();
+    o[u"layerCount"_s] = project->mapLayers().count();
+    if ( canvas )
+    {
+      o[u"canvasExtent"_s] = QgsWasmBridge::rectToJson( canvas->extent(), canvas->mapSettings().destinationCrs().authid() );
+      o[u"scale"_s] = canvas->scale();
+    }
+    return o;
+  }
+
+  QJsonArray layersJson()
+  {
+    QJsonArray a;
+    // layer tree order (top first), the way the user sees it
+    const QList<QgsLayerTreeLayer *> nodes = QgsProject::instance()->layerTreeRoot()->findLayers();
+    for ( QgsLayerTreeLayer *node : nodes )
+    {
+      if ( node->layer() )
+        a.append( QgsWasmBridge::layerToJson( node->layer() ) );
+    }
+    return a;
+  }
+
+  QJsonValue jsonFromText( const QString &text )
+  {
+    const QJsonDocument doc = QJsonDocument::fromJson( text.toUtf8() );
+    if ( doc.isObject() )
+      return doc.object();
+    if ( doc.isArray() )
+      return doc.array();
+    return text;
+  }
+
+  bool isUrl( const QString &s )
+  {
+    return s.startsWith( "http://"_L1, Qt::CaseInsensitive ) || s.startsWith( "https://"_L1, Qt::CaseInsensitive );
+  }
+
+  // Downloads a URL into the virtual filesystem (browser XMLHttpRequest, CORS applies) and returns the local
+  // path. GDAL's /vsicurl/ is not available in this build, so remote files are fetched whole.
+  QString downloadToVfs( const QString &url, QString target = QString() )
+  {
+    if ( target.isEmpty() )
+    {
+      QString name = QUrl( url ).fileName();
+      if ( name.isEmpty() )
+        name = u"download.bin"_s;
+      target = u"/home/web_user/downloads/%1"_s.arg( name );
+    }
+    const int bytes = qgis_wasm_download_sync( url.toUtf8().constData(), target.toUtf8().constData() );
+    if ( bytes < 0 )
+      throw QgsWasmBridgeError( bytes == -1 ? u"download of %1 failed (network error or blocked by CORS)"_s.arg( url ) : u"download of %1 failed (HTTP %2)"_s.arg( url ).arg( -bytes ) );
+    return target;
+  }
