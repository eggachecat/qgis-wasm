+                  const QString kind = str( p, u"kind"_s, u"file"_s ), parentKind = str( p, u"parent"_s, u"active"_s );
+                  QWidget *parent = parentKind == u"main"_s ? static_cast<QWidget *>( QgisApp::instance() ) : parentKind == u"active"_s ? QApplication::activeWindow() : nullptr;
