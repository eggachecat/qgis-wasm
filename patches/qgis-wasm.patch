+  // --- parameter access
+  QString str( const QJsonObject &p, const QString &key, const QString &def = QString() )
+  {
+    const QJsonValue v = p.value( key );
+    if ( v.isString() )
+      return v.toString();
+    if ( v.isDouble() )
+      return QString::number( v.toDouble() );
+    if ( v.isBool() )
+      return v.toBool() ? u"true"_s : u"false"_s;
+    return def;
+  }
+  QString requireStr( const QJsonObject &p, const QString &key )
+  {
+    const QString v = str( p, key );
+    if ( v.isEmpty() )
+      throw QgsWasmBridgeError( u"missing parameter '%1'"_s.arg( key ) );
+    return v;
+  }
+  double num( const QJsonObject &p, const QString &key, double def )
+  {
+    const QJsonValue v = p.value( key );
+    if ( v.isDouble() )
+      return v.toDouble();
+    if ( v.isString() )
+    {
+      bool ok = false;
+      const double d = v.toString().toDouble( &ok );
+      if ( ok )
+        return d;
+    }
+    return def;
+  }
+  double requireNum( const QJsonObject &p, const QString &key )
+  {
+    if ( !p.contains( key ) )
+      throw QgsWasmBridgeError( u"missing parameter '%1'"_s.arg( key ) );
+    return num( p, key, 0 );
+  }
+  int integer( const QJsonObject &p, const QString &key, int def )
+  {
+    return static_cast<int>( num( p, key, def ) );
+  }
+  bool flag( const QJsonObject &p, const QString &key, bool def )
+  {
+    const QJsonValue v = p.value( key );
+    if ( v.isBool() )
+      return v.toBool();
+    if ( v.isString() )
+      return v.toString().compare( "true"_L1, Qt::CaseInsensitive ) == 0 || v.toString() == "1"_L1;
+    if ( v.isDouble() )
+      return v.toDouble() != 0;
+    return def;
+  }
