+                  if ( QAction *old = mActions.take( id ) )
+                  {
+                    appRemovePluginMenu( old->property( "qgisWasmMenu" ).toString(), old );
+                    if ( old->property( "qgisWasmToolbar" ).toBool() )
+                      appRemovePluginToolBarIcon( old );
+                    delete old;
+                  }
+                  QAction *action = new QAction( text, app );
