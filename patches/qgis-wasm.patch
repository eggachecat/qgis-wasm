index 000000000..0519f9764
--- /dev/null
+++ b/cmake/QgisWasmApp.cmake
@@ -0,0 +1,162 @@
+# Finalisation of the QGIS desktop executable for Qt for WebAssembly (Emscripten).
+#
+# Included from src/app/CMakeLists.txt when EMSCRIPTEN is set. The `qgis` target is created with
+# qt_add_executable(MANUAL_FINALIZATION) so that Qt's wasm helpers emit qgis.html + qtloader.js and
+# link the static platform plugin; here we add the Emscripten runtime settings QGIS needs
+# (threads, large heap, virtual filesystem with the QGIS data directory) and finalize the target.
+
+message(STATUS "QGIS desktop: configuring Qt for WebAssembly executable")
+
+# The data directory QGIS expects at runtime (QgsApplication::pkgDataPath()) is
+# ${QGIS_WASM_PREFIX}/${QGIS_DATA_SUBDIR}. QGIS_PREFIX_PATH is set from the HTML shell (Module.ENV).
+set(QGIS_WASM_PREFIX "/qgis" CACHE STRING "Prefix path of the QGIS installation inside the Emscripten virtual filesystem")
+set(QGIS_WASM_DATA "${QGIS_WASM_PREFIX}/${QGIS_DATA_SUBDIR}")
+
+# Optional: PROJ resource directory (proj.db etc.) to preload; set by the top-level build script
+set(QGIS_WASM_PROJ_DATA_DIR "" CACHE PATH "Directory with proj.db to preload at /proj")
+
+set(QGIS_WASM_PRELOAD
+  "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/resources/srs6.db@${QGIS_WASM_DATA}/resources/srs.db"
+  "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/resources/qgis.db@${QGIS_WASM_DATA}/resources/qgis.db"
+  "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/resources/symbology-style.xml@${QGIS_WASM_DATA}/resources/symbology-style.xml"
+  "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/resources/customization.xml@${QGIS_WASM_DATA}/resources/customization.xml"
+  "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/resources/themes@${QGIS_WASM_DATA}/resources/themes"
+  "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/resources/function_help@${QGIS_WASM_DATA}/resources/function_help"
+  "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/resources/metadata-ISO@${QGIS_WASM_DATA}/resources/metadata-ISO"
+  "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/resources/data@${QGIS_WASM_DATA}/resources/data"
+  "SHELL:--preload-file ${CMAKE_SOURCE_DIR}/images/svg@${QGIS_WASM_DATA}/svg"
+)
+# deployment defaults (disable network version check / news feed, ...) — override with QGIS_WASM_GLOBAL_SETTINGS
+set(QGIS_WASM_GLOBAL_SETTINGS "${CMAKE_SOURCE_DIR}/resources/qgis_global_settings.ini" CACHE FILEPATH "qgis_global_settings.ini preloaded into the wasm filesystem")
+list(APPEND QGIS_WASM_PRELOAD "SHELL:--preload-file ${QGIS_WASM_GLOBAL_SETTINGS}@${QGIS_WASM_DATA}/resources/qgis_global_settings.ini")
+if(QGIS_WASM_PROJ_DATA_DIR)
+  list(APPEND QGIS_WASM_PRELOAD "SHELL:--preload-file ${QGIS_WASM_PROJ_DATA_DIR}@/proj")
+endif()
+# optional extra content: fonts registered at startup (see main.cpp) and demo projects/data
+set(QGIS_WASM_FONTS_DIR "" CACHE PATH "Directory with .ttf/.otf fonts to preload at <data>/fonts")
+if(QGIS_WASM_FONTS_DIR)
+  list(APPEND QGIS_WASM_PRELOAD "SHELL:--preload-file ${QGIS_WASM_FONTS_DIR}@${QGIS_WASM_DATA}/fonts")
+endif()
+set(QGIS_WASM_DEMO_DIR "" CACHE PATH "Directory with demo projects/data to preload at <prefix>/share/demo")
+if(QGIS_WASM_DEMO_DIR)
+  list(APPEND QGIS_WASM_PRELOAD "SHELL:--preload-file ${QGIS_WASM_DEMO_DIR}@${QGIS_WASM_PREFIX}/share/demo")
+endif()
+
+# Large, rarely needed resources stay out of qgis.data: each is copied next to qgis.js and listed in qgis.lazy.json
+# (file name, size, place in the virtual filesystem). The browser shell mounts them read-only over HTTP range requests
+# and links every one back to its original path, so QGIS still just opens a file - the bytes come on first read.
+# Entries are <source file>@<path in the virtual filesystem>. Default: the 13 MB world map, read only by the CRS
+# selector preview and the status bar easter eggs.
+set(QGIS_WASM_LAZY_FILES "${CMAKE_SOURCE_DIR}/resources/data/world_map.gpkg@${QGIS_WASM_DATA}/resources/data/world_map.gpkg"
+    CACHE STRING "src@vfs-path pairs served next to qgis.js (listed in qgis.lazy.json) instead of packed into qgis.data")
+set(_qgis_wasm_lazy_json "")
+foreach(_pair IN LISTS QGIS_WASM_LAZY_FILES)
+  string(FIND "${_pair}" "@" _at)
+  string(SUBSTRING "${_pair}" 0 ${_at} _src)
+  math(EXPR _at "${_at} + 1")
+  string(SUBSTRING "${_pair}" ${_at} -1 _vfs)
+  if(NOT EXISTS "${_src}")
+    message(FATAL_ERROR "QGIS_WASM_LAZY_FILES: ${_src} does not exist")
+  endif()
+  get_filename_component(_name "${_src}" NAME)
+  file(SIZE "${_src}" _size)
+  list(APPEND QGIS_WASM_PRELOAD "SHELL:--exclude-file ${_src}")
+  string(APPEND _qgis_wasm_lazy_json "  {\"path\": \"${_name}\", \"vfs\": \"${_vfs}\", \"size\": ${_size}},\n")
+  add_custom_command(TARGET qgis POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_src}" "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/${_name}" VERBATIM)
+  install(FILES "${_src}" DESTINATION ${QGIS_BIN_DIR})
+endforeach()
+string(REGEX REPLACE ",\n$" "\n" _qgis_wasm_lazy_json "${_qgis_wasm_lazy_json}")
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/qgis.lazy.json" "{\"files\": [\n${_qgis_wasm_lazy_json}]}\n")
+add_custom_command(TARGET qgis POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_CURRENT_BINARY_DIR}/qgis.lazy.json" "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/qgis.lazy.json" VERBATIM)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/qgis.lazy.json" DESTINATION ${QGIS_BIN_DIR})
+
+target_link_options(qgis PRIVATE ${QGIS_WASM_PRELOAD})
+
+# Emscripten runtime. Qt's finalizer (Qt6WasmMacros.cmake) emits PTHREAD_POOL_SIZE / INITIAL_MEMORY /
+# MAXIMUM_MEMORY / EXPORTED_RUNTIME_METHODS / MODULARIZE / EXPORT_NAME from these target properties:
+set_target_properties(qgis PROPERTIES
+  # workers are preloaded (PTHREAD_POOL_DELAY_LOAD=0): thread creation must be instant, because QGIS blocks the
+  # main thread while waiting for render jobs. main.cpp caps QGIS at 8 render threads.
+  QT_WASM_PTHREAD_POOL_SIZE "Math.min(Math.max((navigator.hardwareConcurrency||4),8),16)"
+  QT_WASM_INITIAL_MEMORY 512MB
+  QT_WASM_MAXIMUM_MEMORY 4GB
+  QT_WASM_EXTRA_EXPORTED_METHODS "ENV,callMain,IDBFS,addRunDependency,removeRunDependency,ccall,cwrap,PThread"
+)
+target_link_options(qgis PRIVATE
+  "SHELL:-s FORCE_FILESYSTEM=1"
+  "SHELL:-s PTHREAD_POOL_SIZE_STRICT=0"
+  "SHELL:-s PTHREAD_POOL_DELAY_LOAD=0"
+  "SHELL:-s MALLOC=mimalloc"
+  "SHELL:-s EXPORTED_FUNCTIONS=_main,_qgis_wasm_open,_qgis_wasm_call,_qgis_wasm_ready,__emscripten_thread_crashed,__embind_initialize_bindings"
+  "-fwasm-exceptions"
+  "SHELL:-s SUPPORT_LONGJMP=wasm"
+  "-lidbfs.js"
+  "SHELL:-Wl,--error-limit=0"
+)
+# Nested event loops (QDialog::exec(), QMessageBox::exec() ...) need stack switching in the browser
+set(QGIS_WASM_NESTED_LOOPS "jspi" CACHE STRING "Mechanism for nested Qt event loops: jspi | asyncify | none")
+# (Qt detects Asyncify/JSPI at runtime; its suspend import is an EM_ASYNC_JS function, so no import lists are needed)
+# (JS → C++ entry points such as qgis_wasm_open must not suspend themselves: they queue work into Qt's loop)
+if(QGIS_WASM_NESTED_LOOPS STREQUAL "jspi")
+  target_link_options(qgis PRIVATE "SHELL:-s JSPI=1")
+elseif(QGIS_WASM_NESTED_LOOPS STREQUAL "asyncify")
+  target_link_options(qgis PRIVATE "SHELL:-s ASYNCIFY=1" "SHELL:-s ASYNCIFY_STACK_SIZE=65536")
+endif()
+
+if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
+  # keep the post-link wasm-opt pass cheap-ish but still reduce the function count for V8
+  target_link_options(qgis PRIVATE "-O1")
+endif()
+# keep function names in the wasm name section: readable stack traces in the browser (DevTools / CDP)
+option(QGIS_WASM_PROFILING_FUNCS "Keep function names in qgis.wasm for readable stack traces" ON)
+if(QGIS_WASM_PROFILING_FUNCS)
+  target_link_options(qgis PRIVATE "--profiling-funcs")
+endif()
+
+# C++ plugins (src/plugins) are static libraries in this build; main.cpp registers their entry points through
+# src/app/qgswasmstaticplugins.cpp. The plugins are built before src/app (see src/CMakeLists.txt).
+set(QGIS_WASM_STATIC_PLUGINS "plugin_topology;plugin_geometrychecker" CACHE STRING "C++ plugin targets linked into the wasm executable (empty to disable)")
+foreach(_plugin IN LISTS QGIS_WASM_STATIC_PLUGINS)
+  if(TARGET ${_plugin})
+    target_link_libraries(qgis PRIVATE ${_plugin})
+    string(TOUPPER "${_plugin}" _plugin_upper)
+    string(REPLACE "PLUGIN_" "" _plugin_upper "${_plugin_upper}")
+    target_compile_definitions(qgis PRIVATE "QGIS_WASM_PLUGIN_${_plugin_upper}")
+  else()
+    message(WARNING "QGIS_WASM_STATIC_PLUGINS: target ${_plugin} does not exist")
+  endif()
+endforeach()
+
+# The QML module of qgis_app (welcome screen) is a static plugin; qt_import_qml_plugins cannot discover
+# it through QGIS' versionless Qt:: link names, so link the plugin and its Q_IMPORT_PLUGIN stub explicitly.
+if(TARGET qgis_appplugin)
+  target_link_libraries(qgis PRIVATE qgis_appplugin)
+  if(TARGET qgis_appplugin_init)
+    target_link_libraries(qgis PRIVATE qgis_appplugin_init)
+  endif()
+endif()
+
+qt_finalize_executable(qgis)
+# static QML modules (QtQuick, Controls, Layouts, org.qgis.app) used by the welcome page / QML widgets
+qt_import_qml_plugins(qgis)
+
+# Browser shell: Qt generates qgis.html from its template; a deployment provides its own directory with index.html,
+# the shell scripts (bridge, cloud filesystem), presets/ and plugins/, copied next to qgis.js after every link
+set(QGIS_WASM_SHELL_DIR "" CACHE PATH "Directory with index.html and shell assets copied next to qgis.js")
+if(QGIS_WASM_SHELL_DIR)
+  add_custom_command(TARGET qgis POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_directory "${QGIS_WASM_SHELL_DIR}" "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}" VERBATIM)
+  install(DIRECTORY "${QGIS_WASM_SHELL_DIR}/" DESTINATION ${QGIS_BIN_DIR})
+endif()
+set(QGIS_WASM_AGENT_DIR "" CACHE PATH "Directory with the web agent (served as agent/ next to qgis.js)")
+if(QGIS_WASM_AGENT_DIR)
+  add_custom_command(TARGET qgis POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_directory "${QGIS_WASM_AGENT_DIR}" "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/agent" VERBATIM)
+  install(DIRECTORY "${QGIS_WASM_AGENT_DIR}/" DESTINATION ${QGIS_BIN_DIR}/agent)
+endif()
+
+# qt_add_executable's install rules only know about the .js "executable"; ship the whole bundle
+install(FILES
+  ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/qgis.wasm
+  ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/qgis.data
+  ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/qgis.html
+  ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/qtloader.js
+  DESTINATION ${QGIS_BIN_DIR} OPTIONAL)
