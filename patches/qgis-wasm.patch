+  // --- style helpers: a JSON "style document" for layers (layer_style_get / layer_style_set; the PyQGIS compatibility
+  //     layer's renderer / labeling classes map onto it). Colours are CSS: #rrggbb, #rrggbbaa, rgb()/rgba(), names.
+  QColor parseColor( const QString &text )
+  {
+    const QString s = text.trimmed();
+    if ( s.isEmpty() )
+      return QColor();
+    static const QRegularExpression rgba( u"^rgba?\\(\\s*(\\d+)\\s*,\\s*(\\d+)\\s*,\\s*(\\d+)\\s*(?:,\\s*([0-9.]+)\\s*)?\\)$"_s );
+    const QRegularExpressionMatch m = rgba.match( s );
+    if ( m.hasMatch() )
+      return QColor( m.captured( 1 ).toInt(), m.captured( 2 ).toInt(), m.captured( 3 ).toInt(), m.captured( 4 ).isEmpty() ? 255 : static_cast<int>( std::lround( std::clamp( m.captured( 4 ).toDouble(), 0.0, 1.0 ) * 255 ) ) );
+    if ( s.startsWith( '#' ) && s.size() == 9 ) // CSS #rrggbbaa (Qt reads nine characters as #aarrggbb)
+      return QColor( s.mid( 1, 2 ).toInt( nullptr, 16 ), s.mid( 3, 2 ).toInt( nullptr, 16 ), s.mid( 5, 2 ).toInt( nullptr, 16 ), s.mid( 7, 2 ).toInt( nullptr, 16 ) );
+    const QColor c = QColor::fromString( s );
+    if ( !c.isValid() )
+      throw QgsWasmBridgeError( u"not a colour: '%1' (use #rrggbb, #rrggbbaa, rgb()/rgba() or a CSS colour name)"_s.arg( text ) );
+    return c;
+  }
+  QString colorStr( const QColor &c )
+  {
+    return c.alpha() == 255 ? c.name() : u"rgba(%1,%2,%3,%4)"_s.arg( c.red() ).arg( c.green() ).arg( c.blue() ).arg( QString::number( c.alphaF(), 'f', 2 ) );
+  }
+  Qgis::RenderUnit unitFromString( const QString &text, Qgis::RenderUnit def )
+  {
+    const QString u = text.trimmed().toLower();
+    if ( u.isEmpty() )
+      return def;
+    if ( u == "pt"_L1 || u == "points"_L1 || u == "point"_L1 )
+      return Qgis::RenderUnit::Points;
+    if ( u == "mm"_L1 || u == "millimeters"_L1 || u == "millimetres"_L1 )
+      return Qgis::RenderUnit::Millimeters;
+    if ( u == "px"_L1 || u == "pixels"_L1 )
+      return Qgis::RenderUnit::Pixels;
+    if ( u == "map"_L1 || u == "map_units"_L1 || u == "mapunits"_L1 )
+      return Qgis::RenderUnit::MapUnits;
+    if ( u == "m"_L1 || u == "meters"_L1 || u == "metres"_L1 )
+      return Qgis::RenderUnit::MetersInMapUnits;
+    throw QgsWasmBridgeError( u"unknown unit '%1' (points, mm, pixels, map_units, meters)"_s.arg( text ) );
+  }
+  QString unitToString( Qgis::RenderUnit unit )
+  {
+    switch ( unit )
+    {
+      case Qgis::RenderUnit::Points: return u"points"_s;
+      case Qgis::RenderUnit::Millimeters: return u"mm"_s;
+      case Qgis::RenderUnit::Pixels: return u"pixels"_s;
+      case Qgis::RenderUnit::MapUnits: return u"map_units"_s;
+      case Qgis::RenderUnit::MetersInMapUnits: return u"meters"_s;
+      default: return u"other"_s;
+    }
+  }
+  const QList<QPair<QString, Qgis::LabelPlacement>> &placementNames()
+  {
+    static const QList<QPair<QString, Qgis::LabelPlacement>> names {
+      { u"around_point"_s, Qgis::LabelPlacement::AroundPoint }, { u"over_point"_s, Qgis::LabelPlacement::OverPoint },
+      { u"ordered_around_point"_s, Qgis::LabelPlacement::OrderedPositionsAroundPoint }, { u"line"_s, Qgis::LabelPlacement::Line },
+      { u"curved"_s, Qgis::LabelPlacement::Curved }, { u"horizontal"_s, Qgis::LabelPlacement::Horizontal }, { u"free"_s, Qgis::LabelPlacement::Free },
+      { u"perimeter_curved"_s, Qgis::LabelPlacement::PerimeterCurved }, { u"outside_polygons"_s, Qgis::LabelPlacement::OutsidePolygons } };
+    return names;
+  }
+  QString placementToString( Qgis::LabelPlacement placement )
+  {
+    for ( const auto &n : placementNames() )
+      if ( n.second == placement )
+        return n.first;
+    return u"around_point"_s;
+  }
+  Qgis::LabelPlacement placementFromString( const QString &text )
+  {
+    QString t = text.trimmed().toLower();
+    t.replace( ' ', '_' ).replace( '-', '_' );
+    for ( const auto &n : placementNames() )
+      if ( n.first == t )
+        return n.second;
+    if ( t == "point"_L1 || t == "around"_L1 )
+      return Qgis::LabelPlacement::AroundPoint;
+    if ( t == "over"_L1 || t == "center"_L1 || t == "centre"_L1 || t == "centroid"_L1 )
+      return Qgis::LabelPlacement::OverPoint;
+    if ( t == "parallel"_L1 )
+      return Qgis::LabelPlacement::Line;
+    if ( t == "perimeter"_L1 )
+      return Qgis::LabelPlacement::PerimeterCurved;
+    if ( t == "outside"_L1 )
+      return Qgis::LabelPlacement::OutsidePolygons;
+    QStringList all;
+    for ( const auto &n : placementNames() )
+      all << n.first;
+    throw QgsWasmBridgeError( u"unknown label placement '%1' (%2)"_s.arg( text, all.join( ", "_L1 ) ) );
+  }
+  QString classificationModeToString( const QString &methodId )
+  {
+    static const QMap<QString, QString> names { { u"Quantile"_s, u"quantile"_s }, { u"EqualInterval"_s, u"equal_interval"_s }, { u"Jenks"_s, u"jenks"_s }, { u"StdDev"_s, u"stddev"_s }, { u"Pretty"_s, u"pretty"_s }, { u"Logarithmic"_s, u"log"_s }, { u"Fixed"_s, u"fixed_interval"_s }, { u"Custom"_s, u"custom"_s } };
+    return names.value( methodId, methodId );
+  }
+  QString classificationModeFromString( const QString &text )
+  {
+    QString t = text.trimmed().toLower();
+    t.replace( ' ', '_' ).replace( '-', '_' );
+    if ( t.isEmpty() || t == "quantile"_L1 || t == "quantiles"_L1 )
+      return u"Quantile"_s;
+    if ( t == "equal_interval"_L1 || t == "equal"_L1 || t == "equalinterval"_L1 )
+      return u"EqualInterval"_s;
+    if ( t == "jenks"_L1 || t == "natural_breaks"_L1 || t == "natural"_L1 )
+      return u"Jenks"_s;
+    if ( t == "stddev"_L1 || t == "standard_deviation"_L1 || t == "std"_L1 )
+      return u"StdDev"_s;
+    if ( t == "pretty"_L1 || t == "pretty_breaks"_L1 )
+      return u"Pretty"_s;
+    if ( t == "log"_L1 || t == "logarithmic"_L1 )
+      return u"Logarithmic"_s;
