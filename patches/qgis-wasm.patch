+  //! A symbol from its JSON: \a base (cloned) or the default symbol of the geometry type, then every given key applied
+  std::unique_ptr<QgsSymbol> symbolFromJson( Qgis::GeometryType geometryType, const QJsonObject &j, const QgsSymbol *base )
+  {
+    std::unique_ptr<QgsSymbol> symbol( base ? base->clone() : QgsSymbol::defaultSymbol( geometryType ) );
+    if ( !symbol )
+      throw QgsWasmBridgeError( u"the layer has no symbolizable geometry"_s );
+    if ( j.contains( u"color"_s ) )
+      symbol->setColor( parseColor( str( j, u"color"_s ) ) );
+    if ( j.contains( u"opacity"_s ) )
+      symbol->setOpacity( std::clamp( num( j, u"opacity"_s, 1.0 ), 0.0, 1.0 ) );
+    QgsSymbolLayer *layer = symbol->symbolLayerCount() ? symbol->symbolLayer( 0 ) : nullptr;
+    const QString stroke = str( j, u"stroke_color"_s );
+    const QString strokeStyle = str( j, u"stroke_style"_s );
+    if ( QgsSimpleMarkerSymbolLayer *m = dynamic_cast<QgsSimpleMarkerSymbolLayer *>( layer ) )
+    {
+      if ( !stroke.isEmpty() )
+        m->setStrokeColor( parseColor( stroke ) );
+      if ( j.contains( u"stroke_width"_s ) )
+        m->setStrokeWidth( num( j, u"stroke_width"_s, 0.2 ) );
+      if ( !strokeStyle.isEmpty() )
+        m->setStrokeStyle( QgsSymbolLayerUtils::decodePenStyle( strokeStyle ) );
+      if ( j.contains( u"size"_s ) )
+        m->setSize( num( j, u"size"_s, 2 ) );
+      if ( j.contains( u"angle"_s ) )
+        m->setAngle( num( j, u"angle"_s, 0 ) );
+      if ( j.contains( u"shape"_s ) )
+      {
+        bool ok = false;
+        const Qgis::MarkerShape shape = QgsSimpleMarkerSymbolLayerBase::decodeShape( str( j, u"shape"_s ), &ok );
+        if ( !ok )
+          throw QgsWasmBridgeError( u"unknown marker shape '%1' (circle, square, diamond, triangle, star, pentagon, hexagon, cross, cross2, arrow, line, …)"_s.arg( str( j, u"shape"_s ) ) );
+        m->setShape( shape );
+      }
+    }
+    else if ( QgsSimpleLineSymbolLayer *l = dynamic_cast<QgsSimpleLineSymbolLayer *>( layer ) )
+    {
+      if ( j.contains( u"width"_s ) )
+        l->setWidth( num( j, u"width"_s, 0.26 ) );
+      else if ( j.contains( u"stroke_width"_s ) )
+        l->setWidth( num( j, u"stroke_width"_s, 0.26 ) );
+      if ( !stroke.isEmpty() )
+        l->setColor( parseColor( stroke ) );
+      if ( !strokeStyle.isEmpty() )
+        l->setPenStyle( QgsSymbolLayerUtils::decodePenStyle( strokeStyle ) );
+    }
+    else if ( QgsSimpleFillSymbolLayer *f = dynamic_cast<QgsSimpleFillSymbolLayer *>( layer ) )
+    {
+      if ( !stroke.isEmpty() )
+        f->setStrokeColor( parseColor( stroke ) );
+      if ( j.contains( u"stroke_width"_s ) )
+        f->setStrokeWidth( num( j, u"stroke_width"_s, 0.26 ) );
+      if ( !strokeStyle.isEmpty() )
+        f->setStrokeStyle( QgsSymbolLayerUtils::decodePenStyle( strokeStyle ) );
+      if ( j.contains( u"fill_style"_s ) )
+        f->setBrushStyle( QgsSymbolLayerUtils::decodeBrushStyle( str( j, u"fill_style"_s ) ) );
+    }
+    return symbol;
+  }
