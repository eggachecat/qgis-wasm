+  registerTool( u"basemaps_list"_s, u"List the configured XYZ basemap connections (QGIS Browser → XYZ Tiles), e.g. those provided by the deployment preset."_s, schema(), []( const QJsonObject & ) -> QJsonValue {
+    QJsonArray a;
+    const QStringList names = QgsXyzConnectionSettings::sTreeXyzConnections->items();
+    for ( const QString &name : names )
