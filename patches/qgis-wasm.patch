+// Synchronous download into the virtual filesystem. A blocking QNetworkRequest + nested event loop freezes the
+// main thread in this runtime, so (like cloudfs.js) remote files are fetched with a synchronous XMLHttpRequest;
+// the main thread can only receive binary as "x-user-defined" text. Returns the byte count or -(HTTP status).
+EM_JS( int, qgis_wasm_download_sync, ( const char *url, const char *path ), {
+  try {
+    const xhr = new XMLHttpRequest();
+    xhr.open( 'GET', UTF8ToString( url ), false );
+    xhr.overrideMimeType( 'text/plain; charset=x-user-defined' );
+    xhr.send( null );
+    if ( xhr.status === 0 || xhr.status >= 400 )
+      return -( xhr.status || 1 );
+    const text = xhr.responseText || '';
+    const bytes = new Uint8Array( text.length );
+    for ( let i = 0; i < text.length; i++ )
+      bytes[i] = text.charCodeAt( i ) & 0xff;
+    const target = UTF8ToString( path );
+    FS.mkdirTree( target.slice( 0, target.lastIndexOf( '/' ) ) );
+    FS.writeFile( target, bytes );
+    return bytes.length;
+  } catch ( e ) {
+    console.error( 'qgis_wasm_download_sync', e );
+    return -1;
+  }
+} );
