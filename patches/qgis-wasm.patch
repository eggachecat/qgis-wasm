+  registerTool( u"settings_set"_s, u"Write a QGIS setting (user profile)."_s, schema( { { u"key"_s, prop( u"string"_s, u"Setting key"_s ) }, { u"value"_s, QJsonObject { { u"description"_s, u"New value (string, number, boolean or array of strings)"_s } } } }, { u"key"_s, u"value"_s } ), []( const QJsonObject &p ) -> QJsonValue {
