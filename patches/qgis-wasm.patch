+                  return QJsonObject { { u"path"_s, file.fileName() }, { u"size"_s, static_cast<double>( file.size() ) }, { u"text"_s, QString::fromUtf8( data ) }, { u"truncated"_s, data.size() < file.size() } };
+                } );
+
+  registerTool( u"files_write_text"_s, u"Write a text file into the virtual filesystem (e.g. a GeoJSON or CSV to load with layers_add, or a file on a cloud mount)."_s,
+                schema( { { u"path"_s, prop( u"string"_s, u"File path"_s ) }, { u"text"_s, prop( u"string"_s, u"File content"_s ) } }, { u"path"_s, u"text"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+                  const QString path = requireStr( p, u"path"_s );
+                  QDir().mkpath( QFileInfo( path ).absolutePath() );
+                  QFile file( path );
+                  if ( !file.open( QIODevice::WriteOnly | QIODevice::Truncate ) )
+                    throw QgsWasmBridgeError( u"cannot write %1"_s.arg( path ) );
