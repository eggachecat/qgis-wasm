+  } );
+
+  registerTool( u"plugins_load"_s, u"Load (enable) or unload a C++ plugin compiled into this build."_s,
+                schema( { { u"key"_s, prop( u"string"_s, u"Plugin key (see plugins_list), e.g. plugin_topology"_s ) }, { u"load"_s, prop( u"boolean"_s, u"true = load (default), false = unload"_s ) } }, { u"key"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+                  const QString key = requireStr( p, u"key"_s );
+                  if ( !qgisWasmStaticPlugin( key ) )
+                    throw QgsWasmBridgeError( u"no compiled-in plugin '%1'"_s.arg( key ) );
