diff --git a/src/core/qgswasmtrace.h b/src/core/qgswasmtrace.h
new file mode 100644
index 000000000..448662e56
--- /dev/null
+++ b/src/core/qgswasmtrace.h
@@ -0,0 +1,25 @@
+/***************************************************************************
+  qgswasmtrace.h - opt-in tracing for the WebAssembly build
+  Messages go to the browser console when the QGIS_WASM_TRACE environment variable is set.
+ ***************************************************************************/
+#ifndef QGSWASMTRACE_H
+#define QGSWASMTRACE_H
+
+#include <QDebug>
+#include <QtGlobal>
+
+#ifdef __EMSCRIPTEN__
+#define QGIS_WASM_TRACE( msg )                                                   \
+  do                                                                             \
+  {                                                                              \
+    if ( qEnvironmentVariableIsSet( "QGIS_WASM_TRACE" ) )                        \
+      qWarning() << "[wasm-trace]" << __FUNCTION__ << msg;                        \
+  } while ( 0 )
+#else
+#define QGIS_WASM_TRACE( msg ) \
+  do                           \
+  {                            \
+  } while ( 0 )
+#endif
+
+#endif // QGSWASMTRACE_H
