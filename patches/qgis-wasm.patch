--- /dev/null
+++ b/src/app/qgswasmstaticplugins.cpp
@@ -0,0 +1,87 @@
+/***************************************************************************
+    qgswasmstaticplugins.cpp  -  C++ plugins compiled into the WebAssembly build
+                             -------------------
+    begin                : 2026
+ ***************************************************************************
+ *                                                                         *
+ *   This program is free software; you can redistribute it and/or modify  *
+ *   it under the terms of the GNU General Public License as published by  *
+ *   the Free Software Foundation; either version 2 of the License, or     *
+ *   (at your option) any later version.                                   *
+ *                                                                         *
+ ***************************************************************************/
+#ifdef __EMSCRIPTEN__
+
+#include "qgswasmstaticplugins.h"
+
+#include <QFileInfo>
+#include <QtGlobal>
+
+// Entry points of the statically linked plugins (see QGIS_PLUGIN_SYMBOL in src/plugins/qgisplugin.h)
+#define QGIS_WASM_DECLARE_PLUGIN( prefix )                        \
+  extern "C"                                                    \
+  {                                                             \
+    QgisPlugin *prefix##_classFactory( QgisInterface * );        \
+    const QString *prefix##_name();                              \
+    const QString *prefix##_description();                       \
+    const QString *prefix##_category();                          \
+    int prefix##_type();                                         \
+    const QString *prefix##_version();                           \
+    const QString *prefix##_icon();                              \
+    void prefix##_unload( QgisPlugin * );                        \
+  }
+#define QGIS_WASM_PLUGIN_ENTRY( prefix ) \
+  QgsWasmStaticPlugin { QStringLiteral( #prefix ), prefix##_classFactory, prefix##_name, prefix##_description, prefix##_category, prefix##_type, prefix##_version, prefix##_icon, prefix##_unload }
+
+#ifdef QGIS_WASM_PLUGIN_TOPOLOGY
+QGIS_WASM_DECLARE_PLUGIN( plugin_topology )
+#endif
+#ifdef QGIS_WASM_PLUGIN_GEOMETRYCHECKER
+QGIS_WASM_DECLARE_PLUGIN( plugin_geometrychecker )
+#endif
+
+// Qt resources (icons, .ui) of the plugins live in their static libraries: reference them so the linker keeps
+// them. Q_INIT_RESOURCE declares the generated init function, so this must live in the global namespace.
+static void qgisWasmInitPluginResources()
+{
+  static bool done = false;
+  if ( done )
+    return;
+  done = true;
+#ifdef QGIS_WASM_PLUGIN_TOPOLOGY
+  Q_INIT_RESOURCE( topol );
+#endif
+#ifdef QGIS_WASM_PLUGIN_GEOMETRYCHECKER
+  Q_INIT_RESOURCE( pluginres );
+#endif
+}
+
+const QList<QgsWasmStaticPlugin> &qgisWasmStaticPlugins()
+{
+  static const QList<QgsWasmStaticPlugin> sPlugins = []() {
+    qgisWasmInitPluginResources();
+    QList<QgsWasmStaticPlugin> list;
+#ifdef QGIS_WASM_PLUGIN_TOPOLOGY
+    list << QGIS_WASM_PLUGIN_ENTRY( plugin_topology );
+#endif
+#ifdef QGIS_WASM_PLUGIN_GEOMETRYCHECKER
+    list << QGIS_WASM_PLUGIN_ENTRY( plugin_geometrychecker );
+#endif
+    return list;
+  }();
+  return sPlugins;
+}
+
+const QgsWasmStaticPlugin *qgisWasmStaticPlugin( const QString &keyOrPath )
+{
+  const QString key = QFileInfo( keyOrPath ).baseName();
+  const QList<QgsWasmStaticPlugin> &plugins = qgisWasmStaticPlugins();
+  for ( const QgsWasmStaticPlugin &p : plugins )
+  {
+    if ( p.key == key )
+      return &p;
+  }
+  return nullptr;
+}
+
+#endif // __EMSCRIPTEN__
diff --git a/src/app/qgswasmstaticplugins.h b/src/app/qgswasmstaticplugins.h
new file mode 100644
index 000000000..bf2a3d66b
--- /dev/null
+++ b/src/app/qgswasmstaticplugins.h
@@ -0,0 +1,53 @@
+/***************************************************************************
+    qgswasmstaticplugins.h  -  C++ plugins compiled into the WebAssembly build
+                             -------------------
+    begin                : 2026
+ ***************************************************************************
+ *                                                                         *
+ *   This program is free software; you can redistribute it and/or modify  *
+ *   it under the terms of the GNU General Public License as published by  *
+ *   the Free Software Foundation; either version 2 of the License, or     *
+ *   (at your option) any later version.                                   *
+ *                                                                         *
+ ***************************************************************************/
+#ifndef QGSWASMSTATICPLUGINS_H
+#define QGSWASMSTATICPLUGINS_H
+
+#ifdef __EMSCRIPTEN__
+
+#include <QList>
+#include <QString>
+
+class QgisInterface;
+class QgisPlugin;
+
+/**
+ * \brief A C++ plugin linked statically into the WebAssembly executable.
+ *
+ * There is no dlopen() in a static wasm build, so the entry points QGIS normally resolves from a plugin's
+ * shared library (classFactory, name, …) are registered here instead. Plugins are built with
+ * QGIS_PLUGIN_STATIC_NAME=<key> which makes QGIS_PLUGIN_SYMBOL() (qgisplugin.h) prefix the entry points,
+ * e.g. plugin_topology_classFactory, so several plugins can live in one executable.
+ * QgsPluginRegistry / QgsPluginManager consult this table where they would scan the plugin directory.
+ */
+struct QgsWasmStaticPlugin
+{
+  QString key; //!< library base name, e.g. plugin_topology (used in settings as /Plugins/<key>)
+  QgisPlugin *( *classFactory )( QgisInterface * );
+  const QString *( *name )();
+  const QString *( *description )();
+  const QString *( *category )();
+  int ( *type )();
+  const QString *( *version )();
+  const QString *( *icon )();
+  void ( *unload )( QgisPlugin * );
+};
+
+//! All plugins compiled into this build (see QGIS_WASM_STATIC_PLUGINS in cmake/QgisWasmApp.cmake)
+const QList<QgsWasmStaticPlugin> &qgisWasmStaticPlugins();
+
+//! The plugin with the given key (library base name or full path), nullptr if unknown
+const QgsWasmStaticPlugin *qgisWasmStaticPlugin( const QString &keyOrPath );
+
+#endif // __EMSCRIPTEN__
+#endif // QGSWASMSTATICPLUGINS_H
