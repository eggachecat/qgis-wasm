diff --git a/src/plugins/qgisplugin.h b/src/plugins/qgisplugin.h
index 055036a9b..aa2308f65 100644
--- a/src/plugins/qgisplugin.h
+++ b/src/plugins/qgisplugin.h
@@ -185,4 +185,19 @@ typedef const QString *create_date_t();
 //! Typedef for getting the update date status without instantiating the plugin
 typedef const QString *update_date_t();
 
+/**
+ * Entry points of a plugin (classFactory, name, …) are plain C symbols resolved from its shared library.
+ * In a static build (Qt for WebAssembly) several plugins are linked into one executable, so each plugin is
+ * compiled with QGIS_PLUGIN_STATIC_NAME=<library base name> and declares its entry points through
+ * QGIS_PLUGIN_SYMBOL(), which prefixes them (plugin_topology_classFactory, …); the application registers
+ * them in a table (src/app/qgswasmstaticplugins.cpp). For shared-library builds the macro is transparent.
+ */
+#ifdef QGIS_PLUGIN_STATIC_NAME
+#define QGIS_PLUGIN_SYMBOL_CAT2( a, b ) a##_##b
+#define QGIS_PLUGIN_SYMBOL_CAT( a, b ) QGIS_PLUGIN_SYMBOL_CAT2( a, b )
+#define QGIS_PLUGIN_SYMBOL( symbol ) QGIS_PLUGIN_SYMBOL_CAT( QGIS_PLUGIN_STATIC_NAME, symbol )
+#else
+#define QGIS_PLUGIN_SYMBOL( symbol ) symbol
+#endif
+
 #endif // QGISPLUGIN_H
