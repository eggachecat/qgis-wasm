+ *   the Free Software Foundation; either version 2 of the License, or     *
+ *   (at your option) any later version.                                   *
+ *                                                                         *
+ ***************************************************************************/
+#ifndef QGSWASMPRESET_H
+#define QGSWASMPRESET_H
+
+#ifdef __EMSCRIPTEN__
+
+#include <QJsonObject>
+#include <QString>
+
+/**
+ * \brief Deployment preset of a browser QGIS instance.
+ *
+ * The shell page (web/) selects a preset (?preset=<name> → presets/<name>.json), writes it into the virtual
+ * filesystem and points QGIS_WASM_PRESET at it. A preset describes what an organisation wants every user to have:
+ *
+ *   {
+ *     "name": "default", "title": "…",
+ *     "settings":  { "qgis/checkVersion": false, … },         // seeded once into the user profile (user may change them later)
+ *     "enforce":   { … },                                      // written on every start
+ *     "basemaps":  [ { "name": "OpenStreetMap", "url": "https://…/{z}/{x}/{y}.png", "zmin": 0, "zmax": 19 } ],
+ *     "favorites": [ { "path": "/cloud", "name": "Cloud" } ],  // Browser panel favourites + file dialog sidebar
+ *     "plugins_cpp": [ "plugin_topology" ],                    // compiled-in C++ plugins to enable
+ *     "mounts": [ … ], "plugins": [ … ], "open": [ … ],        // handled by the shell page
+ *     "agent": { … }                                            // handled by the web agent (web/agent, docs/05)
+ *   }
+ *
+ * The shell adds "origin" (page origin, used to reach same-origin helpers such as /proxy).
+ */
+namespace QgsWasmPreset
+{
+  //! The loaded preset (empty object when none was given)
+  QJsonObject current();
+
+  //! Loads QGIS_WASM_PRESET and applies settings / basemaps / favourites / plugins to the user profile.
+  //! Call after the user profile's settings are initialised and before QgisApp is created.
+  void apply();
+
+  //! Page origin injected by the shell, e.g. http://127.0.0.1:8123
+  QString origin();
+} // namespace QgsWasmPreset
+
+#endif // __EMSCRIPTEN__
+#endif // QGSWASMPRESET_H
