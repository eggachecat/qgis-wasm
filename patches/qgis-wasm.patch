+  // ---------------------------------------------------------------- UI integration (web plugins)
+  registerTool( u"ui_add_action"_s, u"Add a menu entry (Plugins → <menu> → <text>) and optionally a toolbar button to the QGIS window. Triggering it sends the 'action' event {id} to the page (web plugins)."_s,
+                schema( { { u"id"_s, prop( u"string"_s, u"Unique action id"_s ) }, { u"text"_s, prop( u"string"_s, u"Menu text"_s ) }, { u"menu"_s, prop( u"string"_s, u"Sub menu name under Plugins (default 'Web Plugins')"_s ) },
+                          { u"toolbar"_s, prop( u"boolean"_s, u"Also add a toolbar button"_s ) }, { u"icon"_s, prop( u"string"_s, u"QGIS theme icon name (e.g. mActionAddLayer.svg) or file path"_s ) } },
+                        { u"id"_s, u"text"_s } ),
+                [this]( const QJsonObject &p ) -> QJsonValue {
+                  QgisApp *app = QgisApp::instance();
+                  const QString id = requireStr( p, u"id"_s );
+                  const QString text = requireStr( p, u"text"_s );
