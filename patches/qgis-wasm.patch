+                          { u"add_to_project"_s, prop( u"boolean"_s, u"Also add the basemap as a layer (default false)"_s ) } },
+                        { u"name"_s, u"url"_s } ),
+                []( const QJsonObject &p ) -> QJsonValue {
+                  const QString name = requireStr( p, u"name"_s );
+                  const QString url = requireStr( p, u"url"_s );
+                  const int zmin = integer( p, u"zmin"_s, 0 ), zmax = integer( p, u"zmax"_s, 18 );
+                  QgsXyzConnectionSettings::settingsUrl->setValue( url, name );
+                  QgsXyzConnectionSettings::settingsZmin->setValue( zmin, name );
+                  QgsXyzConnectionSettings::settingsZmax->setValue( zmax, name );
+                  QJsonObject o { { u"name"_s, name }, { u"url"_s, url }, { u"zmin"_s, zmin }, { u"zmax"_s, zmax } };
+                  if ( flag( p, u"add_to_project"_s, false ) )
+                  {
+                    if ( QgsRasterLayer *rl = QgisApp::instance()->addRasterLayer( xyzUri( url, zmin, zmax ), name, u"wms"_s ) )
+                      o[u"layer"_s] = layerToJson( rl );
+                  }
+                  return o;
+                } );
+
+  registerTool( u"basemaps_use"_s, u"Add a configured XYZ basemap connection to the project as the bottom layer."_s, schema( { { u"name"_s, prop( u"string"_s, u"Connection name (see basemaps_list)"_s ) } }, { u"name"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+    const QString name = requireStr( p, u"name"_s );
+    if ( !QgsXyzConnectionSettings::sTreeXyzConnections->items().contains( name ) )
+      throw QgsWasmBridgeError( u"no basemap connection named '%1'"_s.arg( name ) );
+    const QString url = QgsXyzConnectionSettings::settingsUrl->value( name );
+    const QString uri = xyzUri( url, QgsXyzConnectionSettings::settingsZmin->value( name ), QgsXyzConnectionSettings::settingsZmax->value( name ) );
+    QgsRasterLayer *rl = QgisApp::instance()->addRasterLayer( uri, name, u"wms"_s );
+    if ( !rl )
+      throw QgsWasmBridgeError( u"could not create the basemap layer"_s );
+    // move it to the bottom of the layer tree
+    QgsLayerTree *root = QgsProject::instance()->layerTreeRoot();
+    if ( QgsLayerTreeLayer *node = root->findLayer( rl->id() ) )
+    {
+      QgsLayerTreeLayer *clone = node->clone();
+      root->insertChildNode( -1, clone );
+      qobject_cast<QgsLayerTreeGroup *>( node->parent() )->removeChildNode( node );
+    }
+    return layerToJson( rl );
+  } );
+
+  // ---------------------------------------------------------------- files (virtual filesystem)
+  registerTool( u"files_list"_s, u"List a directory of the virtual filesystem. Interesting roots: /cloud (mounted object storage), /home/web_user (persistent user files), /qgis/share/demo (demo data)."_s,
+                schema( { { u"path"_s, prop( u"string"_s, u"Directory path (default /)"_s ) } } ), []( const QJsonObject &p ) -> QJsonValue {
+                  const QString path = str( p, u"path"_s, u"/"_s );
+                  const QDir dir( path );
+                  if ( !dir.exists() )
+                    throw QgsWasmBridgeError( u"no such directory: %1"_s.arg( path ) );
+                  QJsonArray a;
+                  const QFileInfoList entries = dir.entryInfoList( QDir::AllEntries | QDir::NoDotAndDotDot, QDir::DirsFirst | QDir::Name );
+                  for ( const QFileInfo &fi : entries )
+                    a.append( QJsonObject { { u"name"_s, fi.fileName() }, { u"path"_s, fi.filePath() }, { u"dir"_s, fi.isDir() }, { u"size"_s, static_cast<double>( fi.size() ) }, { u"modified"_s, fi.lastModified().toString( Qt::ISODate ) } } );
+                  return a;
+                } );
+
+  registerTool( u"files_read_text"_s, u"Read a text file from the virtual filesystem (first max_bytes, default 64 kB)."_s,
+                schema( { { u"path"_s, prop( u"string"_s, u"File path"_s ) }, { u"max_bytes"_s, prop( u"integer"_s, u"Maximum bytes to return"_s ) } }, { u"path"_s } ), []( const QJsonObject &p ) -> QJsonValue {
+                  QFile file( requireStr( p, u"path"_s ) );
+                  if ( !file.open( QIODevice::ReadOnly ) )
+                    throw QgsWasmBridgeError( u"cannot read %1"_s.arg( file.fileName() ) );
