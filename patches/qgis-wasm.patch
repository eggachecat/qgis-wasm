+
+//! Error raised by a bridge tool; its message is returned to the caller as {"ok": false, "error": ...}
+class QgsWasmBridgeError : public std::runtime_error
+{
+  public:
+    explicit QgsWasmBridgeError( const QString &message )
+      : std::runtime_error( message.toStdString() ) {}
+};
+
+/**
+ * \brief The programmable control surface of the QGIS desktop when it runs in the browser.
+ *
+ * Every operation is a named "tool": a C++ function taking a JSON object and returning a JSON value,
+ * described by a JSON schema. One registry serves all callers:
+ *  - JavaScript on the page: qgis_wasm_call() (main.cpp) → queued into Qt's event loop → result delivered
+ *    through Module.qgisBridgeResolve(id, json); events through Module.qgisBridgeEvent(type, json)
+ *  - the MCP server of scripts/serve.mjs, which forwards tools/list and tools/call to the page
+ *  - the in-app Assistant dock (QgsWasmAssistantDock), which hands the same tools to a language model
+ *  - web plugins (ui_add_action + the "action" event)
+ *
+ * Tools run on the GUI thread from inside Qt's event loop, never directly from a JavaScript→C++ export
+ * (see docs/02-运行时与调试.md §2.1).
+ */
+class QgsWasmBridge : public QObject
+{
+    Q_OBJECT
+  public:
+    using ToolFunction = std::function<QJsonValue( const QJsonObject &params )>;
+
+    struct Tool
+    {
+      QString name;
+      QString description;
+      QJsonObject inputSchema;
+      ToolFunction function;
+    };
+
+    static QgsWasmBridge *instance();
+
+    //! Registers (or replaces) a tool. \a inputSchema is a JSON schema object describing \a params.
+    void registerTool( const QString &name, const QString &description, const QJsonObject &inputSchema, const ToolFunction &function );
+
+    //! MCP style manifest: [{"name", "description", "inputSchema"}]
+    QJsonArray tools() const;
+    QStringList toolNames() const;
+    bool hasTool( const QString &name ) const;
+
+    //! Runs a tool synchronously (GUI thread). Returns {"ok": true, "result": ...} or {"ok": false, "error": "..."}.
+    QJsonObject call( const QString &name, const QJsonObject &params );
+
+    //! Runs a tool and delivers the result to the page through Module.qgisBridgeResolve(requestId, json)
+    void callFromJs( int requestId, const QString &name, const QJsonObject &params );
+
+    //! Sends an event to the page (Module.qgisBridgeEvent(type, json))
+    void emitEvent( const QString &type, const QJsonObject &payload = QJsonObject() );
+
+    //! Connects project / canvas / layer signals to events. Call once QgisApp::completeInitialization() ran.
+    void attachToApp();
+
+    // --- helpers shared with other browser-only parts of the application
+    //! Finds a layer by id or (exact) name; throws QgsWasmBridgeError
+    static QgsMapLayer *resolveLayer( const QString &reference );
+    static QJsonObject layerToJson( QgsMapLayer *layer );
+    static QJsonObject rectToJson( const QgsRectangle &rect, const QString &crs );
+    static QJsonValue variantToJson( const QVariant &value );
+
+  signals:
+    void toolCalled( const QString &name, const QJsonObject &params, const QJsonObject &result );
+
+  private:
+    QgsWasmBridge();
+    void registerBuiltinTools();
+    void hookLayer( QgsMapLayer *layer );
+
+    QMap<QString, Tool> mTools;
+    QHash<QString, QAction *> mActions;
+    bool mAttached = false;
+};
+
+#endif // __EMSCRIPTEN__
+#endif // QGSWASMBRIDGE_H
diff --git a/src/app/qgswasmpreset.cpp b/src/app/qgswasmpreset.cpp
