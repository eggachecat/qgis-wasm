+                    // the static helper QGIS uses, optionally with its (very long) vector filter list
+                    const QString filter = kind == u"staticfilter"_s ? QgsProviderRegistry::instance()->fileVectorFilters() : QString();
+                    QElapsedTimer st; st.start();
+                    fprintf( stderr, "[ui_debug_dialog] static getOpenFileNames parent=%s filterLen=%d\n", parent ? parent->metaObject()->className() : "none", static_cast<int>( filter.size() ) );
+                    QTimer::singleShot( ms, []() { if ( QWidget *w = QApplication::activeModalWidget() ) w->close(); } );
+                    const QStringList files = QFileDialog::getOpenFileNames( parent, u"debug static file dialog"_s, u"/home/web_user"_s, filter );
+                    fprintf( stderr, "[ui_debug_dialog] static returned %d files after %lld ms\n", static_cast<int>( files.size() ), static_cast<long long>( st.elapsed() ) );
+                    return QJsonObject { { u"kind"_s, kind }, { u"parent"_s, parent ? parent->metaObject()->className() : QStringLiteral( "none" ) }, { u"files"_s, static_cast<int>( files.size() ) }, { u"elapsedMs"_s, static_cast<double>( st.elapsed() ) }, { u"filterLen"_s, static_cast<int>( filter.size() ) } };
+                  }
+                  QDialog *dialog = kind == u"file"_s ? static_cast<QDialog *>( new QFileDialog( parent, u"debug file dialog"_s, u"/home/web_user"_s ) ) : new QDialog( parent );
